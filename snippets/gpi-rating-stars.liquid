{%- comment -%}
  Snippet: gpi-rating-stars — 5-star rating with optional count.
  Params: rating (0–5 number), count (optional int), size (sm/md/lg, default md)
{%- endcomment -%}
{%- liquid
  assign r       = rating | default: 0 | times: 1.0
  assign c       = count | default: 0
  assign size_cls = size | default: 'md'
-%}
<div class="gpi-stars gpi-stars--{{ size_cls }}" role="img" aria-label="Rated {{ r }} out of 5 stars{% if c > 0 %} from {{ c }} reviews{% endif %}">
  {%- for i in (1..5) -%}
    {%- assign fill = 0 -%}
    {%- if r >= i -%}{%- assign fill = 100 -%}
    {%- elsif r > i | minus: 1 -%}
      {%- assign delta = r | minus: i | plus: 1 | times: 100 | round -%}
      {%- assign fill = delta -%}
    {%- endif -%}
    <svg class="gpi-star" viewBox="0 0 20 20" aria-hidden="true">
      <defs>
        <linearGradient id="gpi-star-fill-{{ i }}-{{ section.id | default: 'g' }}-{{ forloop.index }}">
          <stop offset="{{ fill }}%" stop-color="var(--gpi-color-accent-gold)"/>
          <stop offset="{{ fill }}%" stop-color="transparent"/>
        </linearGradient>
      </defs>
      <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L10 14.78 4.8 17.5l.99-5.78-4.21-4.1 5.82-.85L10 1.5z"
        fill="url(#gpi-star-fill-{{ i }}-{{ section.id | default: 'g' }}-{{ forloop.index }})"
        stroke="var(--gpi-color-accent-gold)" stroke-width="1"/>
    </svg>
  {%- endfor -%}
  {%- if c > 0 -%}<span class="gpi-stars__count">({{ c }})</span>{%- endif -%}
</div>
