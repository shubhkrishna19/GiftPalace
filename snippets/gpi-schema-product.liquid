{%- comment -%}
  Snippet: gpi-schema-product — Product JSON-LD.
  Renders nothing visible. Use inside the product main section.
{%- endcomment -%}
{%- if product -%}
{%- assign currency = cart.currency.iso_code | default: shop.currency -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "image": [{%- for img in product.images limit: 6 -%}"{{ img | image_url: width: 1200 | prepend: 'https:' }}"{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
  {%- if product.metafields.judgeme.rating -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ product.metafields.judgeme.rating }}",
    "reviewCount": "{{ product.metafields.judgeme.review_count | default: 1 }}"
  },
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "{{ currency }}",
    "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }}",
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>
{%- endif -%}
