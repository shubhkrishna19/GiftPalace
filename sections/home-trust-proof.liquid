<style media="not all" data-gpi-retired-inline>
  /* Design system tokens for trust-proof section */
  :root {
    --color-primary: #d4af37;
    --color-surface: #fafafa;
    --color-text: #1a1a1a;
    --color-text-muted: #666;
    --color-border: #e5e5e5;
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 3rem;
    --shadow-sm: 0 2px 8px rgba(212, 175, 55, 0.08);
    --shadow-md: 0 4px 16px rgba(212, 175, 55, 0.12);
    --shadow-lg: 0 8px 24px rgba(212, 175, 55, 0.15);
    --shadow-xl: 0 20px 48px rgba(212, 175, 55, 0.25);
    --radius-sm: 8px;
    --radius-md: 12px;
    --duration-normal: 300ms;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home-trust-proof {
    background: linear-gradient(180deg, var(--color-surface, #fafafa) 0%, rgba(212, 175, 55, 0.01) 100%);
    color: var(--color-text, #1a1a1a);
  }

  .home-trust-proof__wrapper {
    padding-top: clamp(2.5rem, 5vw, 5rem) !important;
    padding-bottom: clamp(2.5rem, 5vw, 5rem) !important;
    padding-left: clamp(1rem, 4vw, 3rem) !important;
    padding-right: clamp(1rem, 4vw, 3rem) !important;
  }

  /* Header Section */
  .gpi-eyebrow {
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary, #d4af37);
    margin: 0 0 var(--space-sm, 1rem) 0;
  }

  .home-trust-proof__heading {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 var(--space-md, 1.5rem) 0;
    color: var(--color-text, #1a1a1a);
  }

  .home-trust-proof__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-text-muted, #666);
    margin: 0 0 clamp(2rem, 4vw, 3.5rem) 0;
    max-width: 600px;
  }

  /* Metrics Display */
  .home-trust-proof__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: rgba(212, 175, 55, 0.02);
    border-radius: var(--radius-md, 12px);
    border: 1px solid rgba(212, 175, 55, 0.08);
  }

  .home-trust-proof__metrics > div {
    text-align: center;
  }

  .home-trust-proof__metrics strong {
    display: block;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    color: var(--color-primary, #d4af37);
    line-height: 1.2;
    margin-bottom: var(--space-xs, 0.5rem);
  }

  .home-trust-proof__metrics span {
    display: block;
    font-size: clamp(0.875rem, 1.2vw, 1rem);
    color: var(--color-text-muted, #666);
    line-height: 1.4;
  }

  /* Grid of Proof Cards */
  .home-trust-proof__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* Proof Card Styling */
  .home-trust-proof__card {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: var(--radius-md, 12px);
    background: white;
    transition: all var(--duration-normal, 300ms) var(--ease-out-expo);
    display: flex;
    flex-direction: column;
  }

  .home-trust-proof__card:hover {
    border-color: var(--color-primary, #d4af37);
    box-shadow: var(--shadow-lg, 0 8px 24px rgba(212, 175, 55, 0.15));
    transform: translateY(-8px);
  }

  .home-trust-proof__card:focus-within {
    outline: 2px solid var(--color-primary, #d4af37);
    outline-offset: 2px;
  }

  /* Card Number */
  .home-trust-proof__number {
    position: absolute;
    top: clamp(1rem, 2vw, 1.5rem);
    right: clamp(1rem, 2vw, 1.5rem);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 700;
    color: rgba(212, 175, 55, 0.15);
  }

  /* Card Icon */
  .home-trust-proof__icon {
    width: clamp(56px, 8vw, 72px);
    height: clamp(56px, 8vw, 72px);
    margin-bottom: var(--space-md, 1.5rem);
    border-radius: var(--radius-sm, 8px);
    background: rgba(212, 175, 55, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .home-trust-proof__icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Card Label (Title) */
  .home-trust-proof__label {
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 var(--space-sm, 1rem) 0;
    color: var(--color-text, #1a1a1a);
  }

  /* Card Text */
  .home-trust-proof__text {
    font-size: clamp(0.95rem, 1.2vw, 1rem);
    line-height: 1.6;
    color: var(--color-text-muted, #666);
    margin: 0 0 var(--space-md, 1.5rem) 0;
    flex-grow: 1;
  }

  /* Card Link/CTA */
  .home-trust-proof__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs, 0.5rem);
    font-size: clamp(0.9rem, 1.1vw, 0.95rem);
    font-weight: 600;
    color: var(--color-primary, #d4af37);
    text-decoration: none;
    transition: all var(--duration-normal, 300ms) var(--ease-out-expo);
    margin-top: auto;
  }

  .home-trust-proof__link:hover {
    gap: var(--space-sm, 1rem);
    color: #c99f37;
  }

  .home-trust-proof__link:focus-visible {
    outline: 2px solid var(--color-primary, #d4af37);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Dark Mode Support */
  @media (prefers-color-scheme: dark) {
    .home-trust-proof {
      background: linear-gradient(180deg, #1a1a1a 0%, rgba(212, 175, 55, 0.02) 100%);
      color: #f5f5f5;
    }

    .home-trust-proof__heading {
      color: #ffffff;
    }

    .home-trust-proof__description {
      color: #d4d4d4;
    }

    .home-trust-proof__card {
      background: #2a2a2a;
      border-color: rgba(212, 175, 55, 0.15);
    }

    .home-trust-proof__card:hover {
      border-color: var(--color-primary, #d4af37);
    }

    .home-trust-proof__label {
      color: #f5f5f5;
    }

    .home-trust-proof__text {
      color: #b0b0b0;
    }

    .home-trust-proof__metrics {
      background: rgba(212, 175, 55, 0.05);
      border-color: rgba(212, 175, 55, 0.15);
    }

    .home-trust-proof__metrics span {
      color: #b0b0b0;
    }
  }

  /* Tablet Breakpoint */
  @media (max-width: 1024px) {
    .home-trust-proof__grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: clamp(1.25rem, 2.5vw, 1.75rem);
    }

    .home-trust-proof__metrics {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }
  }

  /* Mobile Breakpoint */
  @media (max-width: 640px) {
    .home-trust-proof__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md, 1.5rem);
    }

    .home-trust-proof__metrics {
      grid-template-columns: 1fr;
      gap: var(--space-md, 1.5rem);
    }

    .home-trust-proof__card {
      padding: var(--space-md, 1.5rem);
    }

    .home-trust-proof__number {
      font-size: 1.125rem;
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .home-trust-proof__card,
    .home-trust-proof__link {
      transition: none;
    }

    .home-trust-proof__card:hover {
      transform: none;
    }
  }
</style>

<div class="home-trust-proof section-block-{{ section.id }}">
  <div class="{% if section.settings.container == 'fullwidth' %}container-full{% elsif section.settings.container == '1770' %}container-1770{% elsif section.settings.container == '1170' %}container-1170{% else %}container{% endif %}">
    <div class="home-trust-proof__wrapper" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;">
      
      {% if section.settings.eyebrow != blank %}
        <p class="gpi-eyebrow home-trust-proof__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h2 class="gpi-heading-lg home-trust-proof__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <p class="gpi-body-base home-trust-proof__description">{{ section.settings.description }}</p>
      {% endif %}

      <div class="home-trust-proof__metrics" aria-label="Gift Palace India trust metrics">
        <div>
          <strong>100K</strong>
          <span>online and offline customers</span>
        </div>
        <div>
          <strong>GJEPC</strong>
          <span>lab-tested gemstone confidence</span>
        </div>
        <div>
          <strong>Delhi</strong>
          <span>Chanakyapuri store support</span>
        </div>
      </div>
      
      <div class="home-trust-proof__grid">
        {% assign proof_blocks = section.blocks | where: 'type', 'proof_card' %}
        
        {% for block in proof_blocks %}
          {% liquid
            assign trust_fallback = 'gpi-stone-emerald.webp'
            if forloop.index == 1
              assign trust_fallback = 'gpi-stone-diamond.webp'
            elsif forloop.index == 2
              assign trust_fallback = 'gpi-testimonial-1-woman.webp'
            elsif forloop.index == 3
              assign trust_fallback = 'gpi-atelier.webp'
            elsif forloop.index == 4
              assign trust_fallback = 'gpi-advisor.webp'
            endif
          %}
          <div class="home-trust-proof__card gpi-card" {{ block.shopify_attributes }}>
            
            <span class="home-trust-proof__number">0{{ forloop.index }}</span>

            <div class="home-trust-proof__icon">
              {% if block.settings.icon_image %}
                <img 
                  src="{{ block.settings.icon_image | image_url: width: 60 }}"
                  alt="{{ block.settings.icon_image.alt | escape }}"
                  width="60"
                  height="60"
                  loading="lazy"
                />
              {% else %}
                <img src="{{ trust_fallback | asset_url }}" alt="{{ block.settings.label | default: 'Gift Palace India trust proof' | escape }}" width="160" height="160" loading="lazy">
              {% endif %}
            </div>
            
            {% if block.settings.label != blank %}
              <h3 class="gpi-heading-md home-trust-proof__label">{{ block.settings.label }}</h3>
            {% endif %}
            
            {% if block.settings.text != blank %}
              <p class="gpi-body-base home-trust-proof__text">{{ block.settings.text }}</p>
            {% endif %}
            
            {% if block.settings.cta_label != blank and block.settings.cta_link != blank %}
              <a href="{{ block.settings.cta_link }}" class="gpi-body-small home-trust-proof__link">
                {{ block.settings.cta_label }} &rarr;
              </a>
            {% endif %}
            
          </div>
        {% endfor %}
      </div>
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Proof Section",
  "tag": "section",
  "class": "section-home-trust-proof",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "1770",
      "options": [
        { "value": "container", "label": "Standard" },
        { "value": "1170", "label": "1170px" },
        { "value": "1770", "label": "1770px" },
        { "value": "fullwidth", "label": "Full width" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why trust us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built on authenticity and intention"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "GJEPC lab-tested gemstone confidence, 100K customers, and real support behind every order."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Side padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "proof_card",
      "name": "Trust proof card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "GJEPC Certified"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Shop gemstones backed by lab-tested documentation and clear authenticity support."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Proof Section"
    }
  ]
}
{% endschema %}
