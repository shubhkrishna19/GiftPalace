<div class="home-conversion-section home-conversion-intro-v2 section-block-{{ section.id }}">
  <div class="{% if section.settings.container == 'fullwidth' %}container-full{% elsif section.settings.container == '1770' %}container-1770{% elsif section.settings.container == '1170' %}container-1170{% else %}container{% endif %}">
    <div class="home-conversion-wrapper" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;">
      
      <!-- Trust Indicators Row -->
      {% assign trust_blocks = section.blocks | where: 'type', 'trust_bullet' %}
      {% if trust_blocks.size > 0 %}
        <div class="home-conversion-trust-row">
          {% for block in trust_blocks limit: 3 %}
            <div class="trust-indicator" {{ block.shopify_attributes }}>
              <div class="trust-indicator__icon">✓</div>
              <div class="trust-indicator__content">
                {% if block.settings.title != blank %}
                  <strong class="trust-indicator__title">{{ block.settings.title }}</strong>
                {% endif %}
                {% if block.settings.text != blank %}
                  <span class="trust-indicator__text">{{ block.settings.text }}</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Main Content Grid -->
      <div class="home-conversion-grid">
        <!-- Left Column: Copy & CTAs -->
        <div class="home-conversion-copy-col">
          <div class="home-conversion-copy-content">
            {% if section.settings.eyebrow != blank %}
              <p class="home-conversion-kicker">{{ section.settings.eyebrow }}</p>
            {% endif %}

            {% if section.settings.title != blank %}
              <h1 class="home-conversion-heading">{{ section.settings.title }}</h1>
            {% endif %}

            {% if section.settings.copy != blank %}
              <div class="home-conversion-copy rte">
                {{ section.settings.copy }}
              </div>
            {% endif %}

            <!-- Primary & Secondary CTAs -->
            <div class="home-conversion-cta-group">
              {% if section.settings.primary_label != blank %}
                <a 
                  class="button button--lg button--primary" 
                  {% if section.settings.primary_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.primary_link }}"{% endif %}
                >
                  <span class="button__text">{{ section.settings.primary_label }}</span>
                  <span class="button__arrow">→</span>
                </a>
              {% endif %}
              
              {% if section.settings.secondary_label != blank %}
                <a 
                  class="button button--lg button--outline" 
                  {% if section.settings.secondary_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.secondary_link }}"{% endif %}
                >
                  <span class="button__text">{{ section.settings.secondary_label }}</span>
                  <span class="button__arrow">→</span>
                </a>
              {% endif %}
            </div>
          </div>
        </div>

        <!-- Right Column: Rich Media Panel -->
        <div class="home-conversion-media-col">
          {% assign media_blocks = section.blocks | where: 'type', 'media_panel' %}
          {% if media_blocks.size > 0 %}
            {% for block in media_blocks limit: 1 %}
              <div class="home-conversion-media-panel" {{ block.shopify_attributes }}>
                {% if block.settings.panel_type == 'video' and block.settings.video_url != blank %}
                  <div class="media-panel__video-wrapper">
                    <video 
                      class="media-panel__video" 
                      playsinline 
                      muted 
                      loop 
                      autoplay
                      poster="{{ block.settings.video_poster | image_url: width: 800 }}"
                    >
                      <source src="{{ block.settings.video_url }}" type="video/mp4">
                    </video>
                    <button class="media-panel__play-overlay" aria-label="Play video">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                  </div>
                {% elsif block.settings.image != blank %}
                  <img 
                    src="{{ block.settings.image | image_url: width: 800 }}" 
                    alt="Panel media"
                    class="media-panel__image"
                  >
                {% endif %}
                
                {% if block.settings.panel_title != blank %}
                  <div class="media-panel__content">
                    <h3 class="media-panel__title">{{ block.settings.panel_title }}</h3>
                    {% if block.settings.panel_copy != blank %}
                      <p class="media-panel__copy">{{ block.settings.panel_copy }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- Proof Items / Shopping Paths -->
      {% assign proof_blocks = section.blocks | where: 'type', 'proof_item' %}
      {% if proof_blocks.size > 0 %}
        <div class="home-conversion-proof-section" aria-label="Shop by buying reason">
          <div class="home-conversion-proof-grid">
            {% for block in proof_blocks limit: 3 %}
              <a 
                class="proof-item" 
                {% if block.settings.link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.link }}"{% endif %} 
                {{ block.shopify_attributes }}
              >
                <div class="proof-item__icon">→</div>
                <div class="proof-item__content">
                  {% if block.settings.label != blank %}
                    <h4 class="proof-item__label">{{ block.settings.label }}</h4>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="proof-item__description">{{ block.settings.text }}</p>
                  {% endif %}
                </div>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <!-- Quick Links / Shortcuts -->
      {% assign shortcut_blocks = section.blocks | where: 'type', 'shortcut' %}
      {% if shortcut_blocks.size > 0 %}
        <div class="home-conversion-shortcuts-section">
          <p class="home-conversion-shortcuts-label">Shop by category:</p>
          <div class="home-conversion-shortcuts">
            {% for block in shortcut_blocks limit: 6 %}
              <a 
                class="shortcut-btn" 
                {% if block.settings.link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.link }}"{% endif %} 
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  /* Home Conversion Section v2 - Using Design System Tokens */
  
  .home-conversion-section {
    background: var(--color-background);
    color: var(--color-text-primary);
  }

  .home-conversion-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-6xl);
  }

  /* Trust Indicators */
  .home-conversion-trust-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .trust-indicator {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-background-secondary);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: all var(--duration-normal) var(--ease-out-expo);
  }

  .trust-indicator:hover {
    border-color: var(--color-primary);
    background: var(--color-background-hover);
  }

  .trust-indicator__icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    border-radius: 50%;
    font-weight: var(--font-bold);
    font-size: 18px;
  }

  .trust-indicator__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .trust-indicator__title {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    margin: 0;
    display: block;
  }

  .trust-indicator__text {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: var(--space-xs) 0 0 0;
    display: block;
  }

  /* Main Content Grid */
  .home-conversion-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6xl);
    align-items: center;
    margin-bottom: var(--space-6xl);
  }

  .home-conversion-copy-col {
    display: flex;
    flex-direction: column;
  }

  .home-conversion-copy-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .home-conversion-kicker {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .home-conversion-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .home-conversion-copy {
    font-size: var(--text-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .home-conversion-copy p {
    margin: var(--space-md) 0;
  }

  .home-conversion-cta-group {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* Media Panel */
  .home-conversion-media-col {
    display: flex;
    flex-direction: column;
  }

  .home-conversion-media-panel {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-2xl);
    aspect-ratio: 4/5;
    background: var(--color-background-secondary);
  }

  .media-panel__video-wrapper,
  .media-panel__image {
    width: 100%;
    height: 100%;
  }

  .media-panel__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-panel__image {
    display: block;
    object-fit: cover;
  }

  .media-panel__play-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    background: rgba(212, 175, 55, 0.9);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-normal) ease-out;
    z-index: var(--z-10);
  }

  .media-panel__play-overlay:hover {
    background: var(--color-primary);
    transform: translate(-50%, -50%) scale(1.15);
  }

  .media-panel__play-overlay svg {
    width: 32px;
    height: 32px;
    color: white;
  }

  .media-panel__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-lg);
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
  }

  .media-panel__title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: white;
    margin: 0 0 var(--space-sm) 0;
  }

  .media-panel__copy {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.9);
    margin: 0;
  }

  /* Proof Items Grid */
  .home-conversion-proof-section {
    margin-bottom: var(--space-6xl);
  }

  .home-conversion-proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .proof-item {
    display: flex;
    gap: var(--space-lg);
    padding: var(--space-lg);
    background: var(--color-background-card);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all var(--duration-normal) var(--ease-out-expo);
    cursor: pointer;
  }

  .proof-item:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .proof-item__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius-md);
    font-size: 24px;
    font-weight: var(--font-bold);
  }

  .proof-item__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .proof-item__label {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-xs) 0;
  }

  .proof-item__description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Shortcuts Section */
  .home-conversion-shortcuts-section {
    padding: var(--space-lg);
    background: var(--color-background-secondary);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .home-conversion-shortcuts-label {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-md) 0;
  }

  .home-conversion-shortcuts {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  .shortcut-btn {
    padding: var(--space-sm) var(--space-md);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-decoration: none;
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: all var(--duration-fast) ease-out;
    cursor: pointer;
  }

  .shortcut-btn:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .home-conversion-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4xl);
    }

    .home-conversion-heading {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
    }
  }

  @media (max-width: 768px) {
    .home-conversion-wrapper {
      gap: var(--space-4xl);
    }

    .home-conversion-trust-row {
      grid-template-columns: 1fr;
    }

    .home-conversion-cta-group {
      flex-direction: column;
    }

    .home-conversion-cta-group .button {
      width: 100%;
      text-align: center;
    }

    .home-conversion-media-panel {
      aspect-ratio: 1;
    }

    .home-conversion-proof-grid {
      grid-template-columns: 1fr;
    }

    .home-conversion-shortcuts {
      justify-content: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Home Conversion Intro v2",
  "tag": "section",
  "class": "section-home-conversion-intro-v2",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container Width",
      "default": "1770",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "1170", "label": "1170px" },
        { "value": "1770", "label": "1770px" },
        { "value": "fullwidth", "label": "Full Width" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Gift with Intention"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Main Heading",
      "default": "Meaningful gemstone jewellery that feels intentional"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Body Copy",
      "default": "<p>Explore curated gemstone jewellery, crystal accents, zodiac pieces, and intentional gifting picks. Each piece is selected for its meaning and beauty.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary Button Label",
      "default": "Shop Bestsellers"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary Button Label",
      "default": "Browse by Intention"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Side Padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "trust_bullet",
      "name": "Trust Indicator",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Indicator Title",
          "default": "Verified Reviews"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting Text",
          "default": "1000+ happy customers"
        }
      ]
    },
    {
      "type": "media_panel",
      "name": "Media Panel",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "panel_type",
          "label": "Media Type",
          "default": "image",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (MP4)"
        },
        {
          "type": "image_picker",
          "id": "video_poster",
          "label": "Video Poster/Thumbnail"
        },
        {
          "type": "text",
          "id": "panel_title",
          "label": "Panel Title"
        },
        {
          "type": "text",
          "id": "panel_copy",
          "label": "Panel Copy"
        }
      ]
    },
    {
      "type": "proof_item",
      "name": "Proof Item",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Item Label",
          "default": "Curated Discovery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Find products by meaning and intention"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "shortcut",
      "name": "Quick Link",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link Label",
          "default": "Shop Birthstones"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Conversion Intro v2",
      "blocks": [
        {
          "type": "trust_bullet",
          "settings": {
            "title": "Free Shipping",
            "text": "On orders over ₹2,000"
          }
        },
        {
          "type": "trust_bullet",
          "settings": {
            "title": "Authentic Gems",
            "text": "Certified gemstones"
          }
        },
        {
          "type": "trust_bullet",
          "settings": {
            "title": "Gift Wrapping",
            "text": "Complimentary service"
          }
        }
      ]
    }
  ]
}
{% endschema %}
