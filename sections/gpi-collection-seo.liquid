{%- comment -%} Section: gpi-collection-seo — copy + related collections {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-collection.css' | asset_url }}">

<section class="gpi-collection-seo gpi-section" aria-labelledby="gpi-collection-seo-heading-{{ section.id }}">
  <div class="gpi-container gpi-collection-seo__inner">
    {%- if section.settings.copy != blank -%}
      <div class="gpi-collection-seo__copy rte">
        {%- if section.settings.heading != blank -%}<h2 id="gpi-collection-seo-heading-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
        {{ section.settings.copy }}
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="gpi-collection-seo__related">
        <h3 class="gpi-collection-seo__related-heading">{{ section.settings.related_heading | default: 'Explore further' }}</h3>
        <ul class="gpi-collection-seo__related-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'related' -%}
              {%- assign rel = collections[block.settings.collection] -%}
              <li{{ block.shopify_attributes }}>
                <a href="{{ rel.url | default: block.settings.collection_url }}" class="gpi-collection-seo__related-card">
                  {%- if rel.image -%}{%- render 'gpi-image', image: rel.image, alt: rel.title, sizes: '320px', loading: 'lazy' -%}{%- endif -%}
                  <span class="gpi-collection-seo__related-title">{{ rel.title | default: block.settings.label }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GPI Collection SEO",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "richtext", "id": "copy", "label": "Body copy"},
    {"type": "text", "id": "related_heading", "label": "Related heading", "default": "Explore further"}
  ],
  "blocks": [
    {
      "type": "related",
      "name": "Related collection",
      "limit": 6,
      "settings": [
        {"type": "collection", "id": "collection", "label": "Collection"},
        {"type": "text", "id": "label", "label": "Fallback label"},
        {"type": "url",  "id": "collection_url", "label": "Fallback URL"}
      ]
    }
  ],
  "presets": [{"name": "GPI Collection SEO"}]
}
{% endschema %}
