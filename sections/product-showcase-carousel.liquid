<div class="product-showcase-section section-block-{{ section.id }}">
  <div class="{% if section.settings.container == 'fullwidth' %}container-full{% elsif section.settings.container == '1770' %}container-1770{% elsif section.settings.container == '1170' %}container-1170{% else %}container{% endif %}">
    <div class="product-showcase-wrapper" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;">
      
      <!-- Header -->
      <div class="product-showcase-header">
        {% if section.settings.eyebrow != blank %}
          <p class="product-showcase-kicker">{{ section.settings.eyebrow }}</p>
        {% endif %}
        
        {% if section.settings.title != blank %}
          <h2 class="product-showcase-title">{{ section.settings.title }}</h2>
        {% endif %}
        
        {% if section.settings.description != blank %}
          <p class="product-showcase-description">{{ section.settings.description }}</p>
        {% endif %}
      </div>

      <!-- Carousel Container -->
      <div class="product-showcase-carousel" role="region" aria-label="Product showcase carousel">
        <button class="carousel-button carousel-button--prev" aria-label="Previous products">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="carousel-viewport">
          <div class="carousel-track" data-carousel-track>
            {% assign product_blocks = section.blocks | where: 'type', 'product_card' %}
            {% for block in product_blocks %}
              <div class="carousel-slide product-card-slide" {{ block.shopify_attributes }}>
                <div class="product-card">
                  <!-- Media Container -->
                  <div class="product-card-media">
                    {% if block.settings.image != blank %}
                      <img 
                        src="{{ block.settings.image | image_url: width: 500 }}"
                        alt="{{ block.settings.product_title }}"
                        loading="lazy"
                        class="product-card-image"
                      >
                    {% endif %}
                    
                    {% if block.settings.video_url != blank %}
                      <button class="product-card-video-trigger" aria-label="Play product video">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="currentColor">
                          <circle cx="24" cy="24" r="24" fill="var(--color-primary)" opacity="0.9"/>
                          <polygon points="18,14 18,34 34,24" fill="white"/>
                        </svg>
                      </button>
                    {% endif %}
                    
                    {% if block.settings.badge != blank %}
                      <span class="product-card-badge">{{ block.settings.badge }}</span>
                    {% endif %}
                  </div>

                  <!-- Product Info -->
                  <div class="product-card-content">
                    {% if block.settings.category != blank %}
                      <p class="product-card-category">{{ block.settings.category }}</p>
                    {% endif %}
                    
                    {% if block.settings.product_title != blank %}
                      <h3 class="product-card-title">{{ block.settings.product_title }}</h3>
                    {% endif %}
                    
                    {% if block.settings.description != blank %}
                      <p class="product-card-description">{{ block.settings.description }}</p>
                    {% endif %}

                    <!-- Rating -->
                    {% if block.settings.rating > 0 %}
                      <div class="product-card-rating">
                        {% for i in (1..5) %}
                          <span class="star {% if i <= block.settings.rating %}star--filled{% endif %}">★</span>
                        {% endfor %}
                        <span class="rating-count">({{ block.settings.review_count }})</span>
                      </div>
                    {% endif %}

                    <!-- Price -->
                    {% if block.settings.price != blank %}
                      <div class="product-card-pricing">
                        {% if block.settings.original_price != blank %}
                          <span class="price-original">{{ block.settings.original_price }}</span>
                        {% endif %}
                        <span class="price-current">{{ block.settings.price }}</span>
                      </div>
                    {% endif %}

                    <!-- CTA -->
                    {% if block.settings.cta_label != blank %}
                      <a href="{{ block.settings.product_link }}" class="button button--primary product-card-cta">
                        {{ block.settings.cta_label }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <button class="carousel-button carousel-button--next" aria-label="Next products">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Carousel Indicators -->
      <div class="carousel-indicators" role="tablist" aria-label="Slide indicators">
        {% assign product_blocks = section.blocks | where: 'type', 'product_card' %}
        {% for block in product_blocks %}
          <button class="carousel-indicator" role="tab" aria-label="Go to slide {{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"></button>
        {% endfor %}
      </div>

      <!-- CTA Section -->
      {% if section.settings.cta_show %}
        <div class="product-showcase-cta">
          {% if section.settings.cta_text != blank %}
            <p class="cta-text">{{ section.settings.cta_text }}</p>
          {% endif %}
          {% if section.settings.cta_label != blank %}
            <a href="{{ section.settings.cta_link }}" class="button button--outline">
              {{ section.settings.cta_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
.product-showcase-section {
  background: var(--color-background-primary);
  padding: var(--space-section) 0;
}

.product-showcase-header {
  text-align: center;
  margin-bottom: var(--space-xl);
}

.product-showcase-kicker {
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-primary);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: var(--space-xs);
}

.product-showcase-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-md);
}

.product-showcase-description {
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
  max-width: 600px;
  margin: 0 auto;
}

.product-showcase-carousel {
  position: relative;
  margin: var(--space-lg) 0;
}

.carousel-viewport {
  overflow: hidden;
  border-radius: var(--radius-lg);
}

.carousel-track {
  display: flex;
  gap: var(--space-md);
  transition: transform var(--duration-normal) var(--ease-out-expo);
}

.carousel-slide {
  flex: 0 0 calc(25% - var(--space-md) * 0.75);
  min-width: 0;
}

@media (max-width: 1440px) {
  .carousel-slide {
    flex: 0 0 calc(33.33% - var(--space-md) * 0.66);
  }
}

@media (max-width: 768px) {
  .carousel-slide {
    flex: 0 0 calc(50% - var(--space-md) * 0.5);
  }
}

@media (max-width: 480px) {
  .carousel-slide {
    flex: 0 0 100%;
  }
}

.product-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: all var(--duration-normal) var(--ease-out-expo);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.product-card:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-lg);
  transform: translateY(-8px);
}

.product-card-media {
  position: relative;
  overflow: hidden;
  padding-bottom: 100%;
  background: var(--color-background-secondary);
}

.product-card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--duration-normal) var(--ease-out-expo);
}

.product-card:hover .product-card-image {
  transform: scale(1.05);
}

.product-card-video-trigger {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border: none;
  background: none;
  cursor: pointer;
  animation: pulse 2s infinite;
  z-index: 2;
}

@keyframes pulse {
  0%, 100% { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
}

.product-card-badge {
  position: absolute;
  top: var(--space-md);
  right: var(--space-md);
  background: var(--color-primary);
  color: var(--color-text-on-primary);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  z-index: 1;
}

.product-card-content {
  padding: var(--space-md);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-card-category {
  font-size: var(--text-xs);
  color: var(--color-primary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: var(--space-xs);
}

.product-card-title {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-xs);
}

.product-card-description {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-md);
  flex: 1;
}

.product-card-rating {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
  font-size: var(--text-sm);
}

.star {
  color: var(--color-border);
  font-size: 1em;
}

.star--filled {
  color: var(--color-primary);
}

.rating-count {
  color: var(--color-text-secondary);
}

.product-card-pricing {
  margin-bottom: var(--space-md);
}

.price-original {
  text-decoration: line-through;
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
  margin-right: var(--space-xs);
}

.price-current {
  font-size: var(--text-lg);
  font-weight: var(--font-bold);
  color: var(--color-primary);
}

.product-card-cta {
  width: 100%;
  text-align: center;
}

.carousel-button {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 50%;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--color-text-primary);
  transition: all var(--duration-normal) var(--ease-out-expo);
  z-index: 10;
}

.carousel-button:hover {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-text-on-primary);
}

.carousel-button--prev {
  left: -60px;
}

.carousel-button--next {
  right: -60px;
}

@media (max-width: 1024px) {
  .carousel-button--prev,
  .carousel-button--next {
    position: relative;
    left: auto;
    right: auto;
  }

  .carousel-button--prev {
    order: -1;
  }
}

.carousel-indicators {
  display: flex;
  justify-content: center;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.carousel-indicator {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--color-border);
  border: none;
  cursor: pointer;
  transition: all var(--duration-normal) var(--ease-out-expo);
}

.carousel-indicator[aria-selected="true"] {
  background: var(--color-primary);
  width: 24px;
  border-radius: 5px;
}

.product-showcase-cta {
  text-align: center;
  padding: var(--space-lg) 0;
  border-top: 1px solid var(--color-border);
  margin-top: var(--space-lg);
}

.cta-text {
  font-size: var(--text-lg);
  color: var(--color-text-primary);
  margin-bottom: var(--space-md);
}
</style>

{% schema %}
{
  "name": "Product Showcase Carousel",
  "tag": "section",
  "class": "section-product-showcase",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "1770",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "1170", "label": "1170px" },
        { "value": "1770", "label": "1770px" },
        { "value": "fullwidth", "label": "Full width" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated Selection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Gemstone Jewellery"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore our handpicked collection of meaningful pieces"
    },
    {
      "type": "checkbox",
      "id": "cta_show",
      "label": "Show bottom CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Ready to find your perfect piece?"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Browse All Products"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Side padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "product_title",
          "label": "Product title",
          "default": "Amethyst Engagement Ring"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "Rings"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Product video URL (optional)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Stunning purple gemstone with gold band"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review count",
          "default": "42"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Current price",
          "default": "$299"
        },
        {
          "type": "text",
          "id": "original_price",
          "label": "Original price (optional)",
          "default": "$399"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text (optional)",
          "default": "Best Seller"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "View Product"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase Carousel"
    }
  ]
}
{% endschema %}
