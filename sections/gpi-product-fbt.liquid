{%- comment -%} Section: gpi-product-fbt — Frequently Bought Together bundle (existing FBT product metafield) {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-product.css' | asset_url }}">

{%- liquid
  assign companions = product.metafields.gpi.fbt_products.value | default: empty
  if companions == empty or companions == nil
    if product.collections.first
      assign coll = product.collections.first
      assign companions = coll.products | where: 'available', true
    endif
  endif
  assign max = 2
-%}

{%- if companions != empty and companions.size > 0 -%}
<section class="gpi-fbt gpi-section" aria-labelledby="gpi-fbt-heading-{{ section.id }}">
  <div class="gpi-container">
    <h2 id="gpi-fbt-heading-{{ section.id }}" class="gpi-fbt__heading">{{ section.settings.heading | default: 'Frequently bought together' }}</h2>
    <div class="gpi-fbt__bundle" data-gpi-fbt-bundle>
      <div class="gpi-fbt__items">
        <div class="gpi-fbt__item gpi-fbt__item--main">
          <label class="gpi-fbt__check">
            <input type="checkbox" checked disabled data-gpi-fbt-variant="{{ product.selected_or_first_available_variant.id }}">
            <div class="gpi-fbt__card">
              {%- render 'gpi-image', image: product.featured_image, alt: product.title, sizes: '160px', loading: 'lazy', class: 'gpi-fbt__img' -%}
              <div class="gpi-fbt__info">
                <h3>{{ product.title }}</h3>
                {%- render 'gpi-price', product: product, show_emi: false, show_tax: false -%}
              </div>
            </div>
          </label>
        </div>
        {%- assign added = 0 -%}
        {%- for comp in companions -%}
          {%- if comp.id != product.id and comp.available and added < max -%}
            <span class="gpi-fbt__plus" aria-hidden="true">+</span>
            <div class="gpi-fbt__item">
              <label class="gpi-fbt__check">
                <input type="checkbox" checked data-gpi-fbt-variant="{{ comp.selected_or_first_available_variant.id }}" data-gpi-fbt-price="{{ comp.price }}">
                <div class="gpi-fbt__card">
                  {%- render 'gpi-image', image: comp.featured_image, alt: comp.title, sizes: '160px', loading: 'lazy', class: 'gpi-fbt__img' -%}
                  <div class="gpi-fbt__info">
                    <h3>{{ comp.title }}</h3>
                    {%- render 'gpi-price', product: comp, show_emi: false, show_tax: false -%}
                  </div>
                </div>
              </label>
            </div>
            {%- assign added = added | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="gpi-fbt__summary">
        <p class="gpi-fbt__total-label">Bundle total</p>
        <p class="gpi-fbt__total-value" data-gpi-fbt-total>{{ product.price | money }}</p>
        <button type="button" class="gpi-button gpi-button--primary gpi-button--lg gpi-button--block" data-gpi-fbt-add>Add bundle to bag</button>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var bundle = document.querySelector('[data-gpi-fbt-bundle]');
  if (!bundle) return;
  var totalEl = bundle.querySelector('[data-gpi-fbt-total]');
  var addBtn  = bundle.querySelector('[data-gpi-fbt-add]');
  function recalc() {
    var sum = 0;
    bundle.querySelectorAll('input[type="checkbox"][data-gpi-fbt-variant]').forEach(function (cb) {
      if (cb.checked) {
        var p = parseInt(cb.dataset.gpiFbtPrice || '{{ product.price }}', 10) || 0;
        sum += p;
      }
    });
    if (totalEl) totalEl.textContent = (sum / 100).toLocaleString('en-IN', { style: 'currency', currency: 'INR' });
  }
  bundle.querySelectorAll('input[type="checkbox"]').forEach(function (cb) { cb.addEventListener('change', recalc); });
  if (addBtn) addBtn.addEventListener('click', function () {
    var ids = [];
    bundle.querySelectorAll('input[type="checkbox"][data-gpi-fbt-variant]').forEach(function (cb) { if (cb.checked) ids.push(cb.dataset.gpiFbtVariant); });
    if (!ids.length) return;
    addBtn.disabled = true; addBtn.textContent = 'Adding...';
    var items = ids.map(function (id) { return { id: parseInt(id, 10), quantity: 1 }; });
    fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
      .then(function (r) { return r.json(); })
      .then(function () { window.location.href = '/cart'; })
      .catch(function () { addBtn.disabled = false; addBtn.textContent = 'Try again'; });
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "GPI Product FBT",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Frequently bought together"}
  ],
  "presets": [{"name": "GPI Product FBT"}]
}
{% endschema %}
