{%- comment -%} Section: Testimonials — Customer reviews carousel {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-home-testimonials.css' | asset_url }}">

<section class="home-testimonials" aria-labelledby="home-testimonials-heading">
  <div class="home-testimonials__header">
    {% if section.settings.title != blank %}
      <h2 id="home-testimonials-heading" class="home-testimonials__title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="home-testimonials__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="home-testimonials__grid">
      {% for block in section.blocks %}
        <article class="home-testimonials__item" {{ block.shopify_attributes }}>
          <div class="home-testimonials__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
            {% for i in (1..5) %}
              {% if i <= block.settings.rating %}
                {% render 'icon-star' %}
              {% endif %}
            {% endfor %}
          </div>

          <blockquote class="home-testimonials__text">
            "{{ block.settings.review_text | escape }}"
          </blockquote>

          <footer class="home-testimonials__footer">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 100, height: 100, crop: 'center' }}"
                alt="{{ block.settings.image.alt | default: block.settings.author_name | escape }}"
                class="home-testimonials__image"
                loading="lazy"
                width="48"
                height="48"
              >
            {% else %}
              <div class="home-testimonials__image home-testimonials__image--placeholder" aria-hidden="true"></div>
            {% endif %}
            <div class="home-testimonials__meta">
              <cite class="home-testimonials__name">{{ block.settings.author_name | escape }}</cite>
              {% if block.settings.location != blank %}
                <span class="home-testimonials__location">{{ block.settings.location | escape }}</span>
              {% endif %}
            </div>
          </footer>
        </article>
      {% endfor %}
    </div>

    {%- comment -%} Schema.org Structured Data {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "itemListElement": [
        {% for block in section.blocks %}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "item": {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "{{ block.settings.rating }}",
              "bestRating": "5"
            },
            "author": {
              "@type": "Person",
              "name": "{{ block.settings.author_name | escape }}"
            },
            "reviewBody": "{{ block.settings.review_text | escape }}",
            "publisher": {
              "@type": "Organization",
              "name": "Gift Palace India"
            }
          }
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
    </script>
  {% endif %}
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Trusted by thousands of gemstone enthusiasts worldwide for our quality, authenticity, and dedicated service."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Customer Name",
          "default": "Ananya Sharma"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Mumbai, India"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "The gemstone I received is absolutely stunning and exactly as described. The certification gives me great peace of mind. Excellent service!"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Image (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author_name": "Ananya Sharma",
            "location": "Mumbai, India",
            "rating": 5,
            "review_text": "The gemstone I received is absolutely stunning and exactly as described. The certification gives me great peace of mind. Excellent service!"
          }
        },
        {
          "type": "review",
          "settings": {
            "author_name": "Rahul Mehta",
            "location": "Delhi, India",
            "rating": 5,
            "review_text": "Gift Palace India is my go-to for authentic gemstones. Their collection is vast and the quality is unmatched. Highly recommend to anyone looking for genuine stones."
          }
        },
        {
          "type": "review",
          "settings": {
            "author_name": "Priya Patel",
            "location": "Ahmedabad, India",
            "rating": 4,
            "review_text": "Great experience overall. The customer support was very helpful in helping me choose the right stone for my needs. Shipping was also quite fast."
          }
        }
      ]
    }
  ]
}
{% endschema %}
