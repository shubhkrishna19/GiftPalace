{%- comment -%} Section: home-press-strip - Compact logo strip. Auto-hides when no logo blocks have an image (avoids empty/broken state). {%- endcomment -%}
{%- liquid
  assign has_real_logos = false
  for b in section.blocks
    if b.settings.logo_image != blank
      assign has_real_logos = true
      break
    endif
  endfor
-%}
{%- if has_real_logos -%}
<link rel="stylesheet" href="{{ 'component-home-press-strip.css' | asset_url }}">

<section class="home-press-strip" aria-labelledby="home-press-strip-heading">
  <div class="home-press-strip__inner">
    <div class="home-press-strip__header">
      {% if section.settings.eyebrow != blank %}
        <p class="home-press-strip__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 id="home-press-strip-heading" class="home-press-strip__title">{{ section.settings.title | escape }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="home-press-strip__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="home-press-strip__logos" aria-label="{{ section.settings.logo_group_label | escape }}">
        {% for block in section.blocks %}
          {% liquid
            assign logo_label = block.settings.logo_label | default: block.settings.logo_image.alt | default: 'Press mention'
          %}

          {% if block.settings.logo_url != blank %}
            <a class="home-press-strip__logo" href="{{ block.settings.logo_url }}" aria-label="{{ logo_label | escape }}" {{ block.shopify_attributes }}>
          {% else %}
            <div class="home-press-strip__logo" aria-label="{{ logo_label | escape }}" {{ block.shopify_attributes }}>
          {% endif %}

            {% if block.settings.logo_image != blank %}
              <img
                src="{{ block.settings.logo_image | image_url: width: 240 }}"
                srcset="
                  {{ block.settings.logo_image | image_url: width: 160 }} 160w,
                  {{ block.settings.logo_image | image_url: width: 240 }} 240w,
                  {{ block.settings.logo_image | image_url: width: 360 }} 360w
                "
                sizes="(max-width: 768px) 44vw, 180px"
                alt="{{ logo_label | escape }}"
                class="home-press-strip__logo-image"
                loading="lazy"
                width="240"
                height="96"
              >
            {% else %}
              <span class="home-press-strip__logo-text">{{ logo_label | escape }}</span>
            {% endif %}

          {% if block.settings.logo_url != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Press Mentions",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Seen and trusted"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Proof points that sit quietly, not loudly."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Use this strip for press mentions, associations, marketplace proof, or trusted jewellery ecosystem partners."
    },
    {
      "type": "text",
      "id": "logo_group_label",
      "label": "Logo group accessibility label",
      "default": "Gift Palace India proof and press logos"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "logo_label",
          "label": "Logo label",
          "default": "GJEPC"
        },
        {
          "type": "url",
          "id": "logo_url",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Mentions",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "logo_label": "GJEPC"
          }
        },
        {
          "type": "logo",
          "settings": {
            "logo_label": "Certified Gemstones"
          }
        },
        {
          "type": "logo",
          "settings": {
            "logo_label": "Since 1989"
          }
        },
        {
          "type": "logo",
          "settings": {
            "logo_label": "Insured Delivery"
          }
        },
        {
          "type": "logo",
          "settings": {
            "logo_label": "Human Consultation"
          }
        }
      ]
    }
  ]
}
{% endschema %}
