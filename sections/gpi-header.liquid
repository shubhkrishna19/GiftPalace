{%- comment -%} Section: gpi-header — three-row layout with announce strip + currency, oversized centered logo, nav + utility cluster {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-header.css' | asset_url }}">

{%- liquid
  assign sticky_cls = ''
  if section.settings.sticky
    assign sticky_cls = ' gpi-header--sticky'
  endif
  assign transparent_cls = ''
  if section.settings.transparent_on_home and template.name == 'index'
    assign transparent_cls = ' gpi-header--transparent'
  endif
  assign logo_max = section.settings.logo_max_height | default: 44
-%}

<header class="gpi-header{{ sticky_cls }}{{ transparent_cls }}" data-gpi-header role="banner">

  {%- if section.blocks.size > 0 -%}
    <div class="gpi-header__row gpi-header__row--announce">
      <div class="gpi-container gpi-header__announce">
        <div class="gpi-header__announce-track" data-gpi-announce>
          {%- for block in section.blocks -%}
            {%- if block.type == 'announcement' -%}
              <span class="gpi-header__announce-item"{{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                {%- else -%}{{ block.settings.text }}
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- render 'gpi-currency-switcher' -%}
      </div>
    </div>
  {%- endif -%}

  <div class="gpi-header__row gpi-header__row--brand">
    <div class="gpi-container gpi-header__brand-inner">
      <button class="gpi-header__menu-toggle" type="button" aria-label="Open menu" aria-controls="gpi-mobile-nav" data-gpi-menu-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <a href="{{ routes.root_url }}" class="gpi-header__logo" aria-label="{{ shop.name }} home">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_w = section.settings.logo.width | at_most: 400 -%}
          <img src="{{ section.settings.logo | image_url: width: logo_w }}"
               srcset="{{ section.settings.logo | image_url: width: logo_w }} 1x, {{ section.settings.logo | image_url: width: logo_w | times: 2 }} 2x"
               alt="{{ shop.name | escape }}"
               width="{{ section.settings.logo.width }}"
               height="{{ section.settings.logo.height }}"
               style="max-height: {{ logo_max }}px;">
        {%- else -%}
          <span class="gpi-header__wordmark">
            {%- if section.settings.show_gem_glyph -%}
              <svg class="gpi-header__gem" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3l8 8-8 18L8 11l8-8zM8 11h16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            {%- endif -%}
            {{ section.settings.wordmark | default: shop.name }}
          </span>
        {%- endif -%}
      </a>
      <div class="gpi-header__utility">
        {%- if section.settings.show_search -%}
          <button class="gpi-header__icon-btn" type="button" aria-label="Open search" data-gpi-search-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
        {%- endif -%}
        <a class="gpi-header__icon-btn gpi-header__wishlist" href="/pages/wishlist" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><path d="M12 21s-7-4.35-7-10a4.5 4.5 0 018-2.83A4.5 4.5 0 0119 11c0 5.65-7 10-7 10z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <span class="gpi-header__badge" data-gpi-wishlist-count hidden>0</span>
        </a>
        {%- if section.settings.show_account -%}
          <a class="gpi-header__icon-btn" href="{% if customer %}/account{% else %}/account/login{% endif %}" aria-label="Account">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </a>
        {%- endif -%}
        <a class="gpi-header__icon-btn gpi-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><path d="M5 6h14l-1.5 11a2 2 0 01-2 1.7H8.5A2 2 0 016.5 17L5 6zM9 6V4a3 3 0 016 0v2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <span class="gpi-header__badge" data-gpi-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="gpi-header__row gpi-header__row--nav" data-gpi-nav-row>
    <div class="gpi-container">
      <nav class="gpi-header__nav" aria-label="Primary">
        {%- if section.settings.main_menu != blank -%}
          {%- assign menu = linklists[section.settings.main_menu] -%}
          <ul class="gpi-header__nav-list" role="list">
            {%- for link in menu.links -%}
              <li class="gpi-header__nav-item{% if link.links.size > 0 %} gpi-header__nav-item--has-mega{% endif %}">
                <a href="{{ link.url }}" class="gpi-header__nav-link"{% if link.links.size > 0 %} aria-haspopup="true" aria-expanded="false"{% endif %}>
                  {{ link.title }}
                  {%- if link.links.size > 0 -%}
                    <svg viewBox="0 0 12 8" aria-hidden="true" width="10" height="6"><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  {%- endif -%}
                </a>
                {%- if link.links.size > 0 -%}{%- render 'gpi-mega-menu', linklist: link.links -%}{%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>
    </div>
  </div>

  {%- if section.settings.show_search -%}
    <div class="gpi-header__search" data-gpi-search hidden>
      <div class="gpi-container">
        <form action="{{ routes.search_url }}" method="get" role="search">
          <input type="search" name="q" placeholder="Search for ruby, neelam, zodiac…" aria-label="Search" autocomplete="off">
          <button type="submit" class="gpi-button gpi-button--primary gpi-button--md">Search</button>
          <button type="button" class="gpi-button gpi-button--text" data-gpi-search-close aria-label="Close search">✕</button>
        </form>
      </div>
    </div>
  {%- endif -%}

  <div class="gpi-header__mobile-nav" id="gpi-mobile-nav" data-gpi-mobile-nav hidden>
    <div class="gpi-header__mobile-inner">
      <button class="gpi-header__icon-btn" type="button" aria-label="Close menu" data-gpi-menu-close>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      {%- if section.settings.main_menu != blank -%}
        {%- assign menu = linklists[section.settings.main_menu] -%}
        <ul class="gpi-header__mobile-list" role="list">
          {%- for link in menu.links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
              {%- if link.links.size > 0 -%}
                <ul role="list">
                  {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

</header>

<script src="{{ 'gpi-currency.js' | asset_url }}" defer></script>
<script src="{{ 'gpi-wishlist.js' | asset_url }}" defer></script>
<script src="{{ 'gpi-header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "GPI Header",
  "settings": [
    {"type": "image_picker", "id": "logo", "label": "Logo image (optional — wordmark used if blank)"},
    {"type": "range", "id": "logo_max_height", "min": 24, "max": 80, "step": 2, "default": 44, "unit": "px", "label": "Logo max height"},
    {"type": "text", "id": "wordmark", "label": "Wordmark text (used if no logo image)", "default": "GIFT PALACE"},
    {"type": "checkbox", "id": "show_gem_glyph", "label": "Show gem glyph next to wordmark", "default": true},
    {"type": "link_list", "id": "main_menu", "label": "Primary menu", "default": "main-menu"},
    {"type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true},
    {"type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true},
    {"type": "checkbox", "id": "sticky", "label": "Sticky on scroll", "default": true},
    {"type": "checkbox", "id": "transparent_on_home", "label": "Transparent over homepage hero", "default": false}
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 5,
      "settings": [
        {"type": "text", "id": "text", "label": "Message", "default": "Free India shipping above ₹2,999"},
        {"type": "url", "id": "link", "label": "Link (optional)"}
      ]
    }
  ],
  "presets": [
    {"name": "GPI Header", "blocks": [
      {"type": "announcement", "settings": {"text": "Free India shipping above ₹2,999"}},
      {"type": "announcement", "settings": {"text": "BIS hallmarked & GJEPC certified"}},
      {"type": "announcement", "settings": {"text": "7-day easy returns"}}
    ]}
  ]
}
{% endschema %}
