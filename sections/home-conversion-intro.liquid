<section class="home-conversion-intro" aria-labelledby="home-conversion-intro-heading" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="{% if section.settings.container == 'fullwidth' %}container-full{% elsif section.settings.container == '1770' %}container-1770{% elsif section.settings.container == '1170' %}container-1170{% else %}container{% endif %}">
    <div class="home-conversion-intro__shell" style="padding-left: {{ section.settings.padding_horizontal }}px; padding-right: {{ section.settings.padding_horizontal }}px;">
      <div class="home-conversion-intro__main">
        <div class="home-conversion-intro__header">
          {% if section.settings.eyebrow %}
            <p class="home-conversion-intro__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}
          {% if section.settings.title %}
            <h2 id="home-conversion-intro-heading" class="home-conversion-intro__title">{{ section.settings.title }}</h2>
          {% endif %}
          {% if section.settings.copy %}
            <div class="home-conversion-intro__copy">{{ section.settings.copy }}</div>
          {% endif %}
        </div>

        <div class="home-conversion-intro__trust-section">
          {% for block in section.blocks %}
            {% if block.type == 'trust_bullet' %}
              <div class="home-conversion-intro__trust-bullet" {{ block.shopify_attributes }}>
                <h3 class="home-conversion-intro__trust-bullet-title">{{ block.settings.title }}</h3>
                <p class="home-conversion-intro__trust-bullet-text">{{ block.settings.text }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="home-conversion-intro__cta">
          {% if section.settings.primary_label and section.settings.primary_link %}
            <a href="{{ section.settings.primary_link }}" class="home-conversion-intro__cta-primary button">
              {{ section.settings.primary_label }}
            </a>
          {% endif %}
          {% if section.settings.secondary_label and section.settings.secondary_link %}
            <a href="{{ section.settings.secondary_link }}" class="home-conversion-intro__cta-secondary button button--secondary">
              {{ section.settings.secondary_label }}
            </a>
          {% endif %}
        </div>

        <div class="home-conversion-intro__visual" aria-label="Gemstone buying paths">
          <figure class="home-conversion-intro__visual-card home-conversion-intro__visual-card--large">
            <img
              src="{{ 'gpi-hero-crystal.webp' | asset_img_url: '640x' }}"
              srcset="{{ 'gpi-hero-crystal.webp' | asset_img_url: '480x' }} 480w, {{ 'gpi-hero-crystal.webp' | asset_img_url: '640x' }} 640w, {{ 'gpi-hero-crystal.webp' | asset_img_url: '900x' }} 900w"
              sizes="(max-width: 768px) 82vw, 420px"
              alt="Blue crystal gemstone for intention-led shopping"
              width="640"
              height="760"
              loading="lazy"
              decoding="async"
            >
          </figure>
          <figure class="home-conversion-intro__visual-card home-conversion-intro__visual-card--small home-conversion-intro__visual-card--ruby">
            <img
              src="{{ 'gpi-stone-ruby.webp' | asset_img_url: '360x' }}"
              srcset="{{ 'gpi-stone-ruby.webp' | asset_img_url: '240x' }} 240w, {{ 'gpi-stone-ruby.webp' | asset_img_url: '360x' }} 360w, {{ 'gpi-stone-ruby.webp' | asset_img_url: '540x' }} 540w"
              sizes="(max-width: 768px) 42vw, 240px"
              alt="Ruby gemstone gift selection"
              width="360"
              height="420"
              loading="lazy"
              decoding="async"
            >
          </figure>
          <figure class="home-conversion-intro__visual-card home-conversion-intro__visual-card--pearl">
            <img
              src="{{ 'gpi-stone-pearl.webp' | asset_img_url: '360x' }}"
              srcset="{{ 'gpi-stone-pearl.webp' | asset_img_url: '240x' }} 240w, {{ 'gpi-stone-pearl.webp' | asset_img_url: '360x' }} 360w, {{ 'gpi-stone-pearl.webp' | asset_img_url: '540x' }} 540w"
              sizes="(max-width: 768px) 42vw, 240px"
              alt="Pearl gemstone jewellery selection"
              width="360"
              height="420"
              loading="lazy"
              decoding="async"
            >
          </figure>
        </div>
      </div>

      <div class="home-conversion-intro__proof-panel">
        {% if section.settings.panel_kicker != blank %}
          <p class="home-conversion-intro__panel-kicker">{{ section.settings.panel_kicker }}</p>
        {% endif %}
        {% if section.settings.panel_title != blank %}
          <h3 class="home-conversion-intro__panel-title">{{ section.settings.panel_title }}</h3>
        {% endif %}
        {% if section.settings.panel_copy != blank %}
          <div class="home-conversion-intro__panel-copy">{{ section.settings.panel_copy }}</div>
        {% endif %}

        <div class="home-conversion-intro__proof-items">
          {% for block in section.blocks %}
            {% if block.type == 'proof_item' %}
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="home-conversion-intro__proof-item" {{ block.shopify_attributes }}>
                  <span class="home-conversion-intro__proof-item-label">{{ block.settings.label }}</span>
                  <span class="home-conversion-intro__proof-item-text">{{ block.settings.text }}</span>
                </a>
              {% else %}
                <div class="home-conversion-intro__proof-item" {{ block.shopify_attributes }}>
                  <span class="home-conversion-intro__proof-item-label">{{ block.settings.label }}</span>
                  <span class="home-conversion-intro__proof-item-text">{{ block.settings.text }}</span>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="home-conversion-intro__shortcuts" aria-label="Popular shopping paths">
        {% for block in section.blocks %}
          {% if block.type == 'shortcut' and block.settings.label != blank %}
            <a href="{{ block.settings.link }}" class="home-conversion-intro__shortcut" {{ block.shopify_attributes }}>
              {{ block.settings.label }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Conversion Intro",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Section Copy"
    },
    {
      "type": "text",
      "id": "panel_kicker",
      "label": "Panel Kicker"
    },
    {
      "type": "text",
      "id": "panel_title",
      "label": "Panel Title"
    },
    {
      "type": "richtext",
      "id": "panel_copy",
      "label": "Panel Copy"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary Button Label"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary Button Label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding Horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "text",
      "id": "container",
      "label": "Container Width"
    }
  ],
  "blocks": [
    {
      "type": "trust_bullet",
      "name": "Trust Bullet",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "proof_item",
      "name": "Proof Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "shortcut",
      "name": "Shortcut",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Conversion Intro"
    }
  ]
}
{% endschema %}
