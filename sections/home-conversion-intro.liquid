<link rel="stylesheet" href="{{ 'component-home-conversion-intro.css' | asset_url }}">

<section class="home-conversion-intro" aria-labelledby="home-conversion-intro-heading">
  <div class="home-conversion-intro__header">
    {% if section.settings.eyebrow %}
      <p class="home-conversion-intro__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.title %}
      <h2 id="home-conversion-intro-heading" class="home-conversion-intro__title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.copy %}
      <div class="home-conversion-intro__copy">{{ section.settings.copy }}</div>
    {% endif %}
  </div>

  <div class="home-conversion-intro__trust-section">
    {% for block in section.blocks %}
      {% if block.type == 'trust_bullet' %}
        <div class="home-conversion-intro__trust-bullet" {{ block.shopify_attributes }}>
          <h3 class="home-conversion-intro__trust-bullet-title">{{ block.settings.title }}</h3>
          <p class="home-conversion-intro__trust-bullet-text">{{ block.settings.text }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="home-conversion-intro__proof-panel">
    {% if section.settings.panel_kicker %}
      <p class="home-conversion-intro__panel-kicker">{{ section.settings.panel_kicker }}</p>
    {% endif %}
    {% if section.settings.panel_title %}
      <h3 class="home-conversion-intro__panel-title">{{ section.settings.panel_title }}</h3>
    {% endif %}
    {% if section.settings.panel_copy %}
      <div class="home-conversion-intro__panel-copy">{{ section.settings.panel_copy }}</div>
    {% endif %}

    <div class="home-conversion-intro__proof-items">
      {% for block in section.blocks %}
        {% if block.type == 'proof_item' %}
          <div class="home-conversion-intro__proof-item" {{ block.shopify_attributes }}>
            <p class="home-conversion-intro__proof-item-label">{{ block.settings.label }}</p>
            <p class="home-conversion-intro__proof-item-text">{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="home-conversion-intro__shortcuts">
    {% for block in section.blocks %}
      {% if block.type == 'shortcut' %}
        <a href="{{ block.settings.link }}" class="home-conversion-intro__shortcut" {{ block.shopify_attributes }}>
          {{ block.settings.label }}
        </a>
      {% endif %}
    {% endfor %}
  </div>

  <div class="home-conversion-intro__cta">
    {% if section.settings.primary_label and section.settings.primary_link %}
      <a href="{{ section.settings.primary_link }}" class="home-conversion-intro__cta-primary button">
        {{ section.settings.primary_label }}
      </a>
    {% endif %}
    {% if section.settings.secondary_label and section.settings.secondary_link %}
      <a href="{{ section.settings.secondary_link }}" class="home-conversion-intro__cta-secondary button button--secondary">
        {{ section.settings.secondary_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Conversion Intro",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Section Copy"
    },
    {
      "type": "text",
      "id": "panel_kicker",
      "label": "Panel Kicker"
    },
    {
      "type": "text",
      "id": "panel_title",
      "label": "Panel Title"
    },
    {
      "type": "richtext",
      "id": "panel_copy",
      "label": "Panel Copy"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary Button Label"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary Button Label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding Horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "text",
      "id": "container",
      "label": "Container Width",
      "default": "1770"
    }
  ],
  "blocks": [
    {
      "type": "trust_bullet",
      "name": "Trust Bullet",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "proof_item",
      "name": "Proof Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "shortcut",
      "name": "Shortcut",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Conversion Intro"
    }
  ]
}
{% endschema %}
