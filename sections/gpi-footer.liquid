{%- comment -%} Section: gpi-footer — brand, 4 link columns (menu OR inline), newsletter+currency, trust strip, social, legal {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-footer.css' | asset_url }}">

{%- liquid
  comment
    Bucket "link_item" blocks by their column setting so default preset can
    populate footer without admin menu setup.
  endcomment
  assign cols_shop    = ''
  assign cols_about   = ''
  assign cols_help    = ''
  assign cols_connect = ''
  for block in section.blocks
    if block.type == 'link_item'
      assign label = block.settings.label
      assign url   = block.settings.link
      assign row   = label | append: '|' | append: url | append: '||'
      case block.settings.column
        when 'shop'    then assign cols_shop    = cols_shop    | append: row
        when 'about'   then assign cols_about   = cols_about   | append: row
        when 'help'    then assign cols_help    = cols_help    | append: row
        when 'connect' then assign cols_connect = cols_connect | append: row
      endcase
    endif
  endfor
-%}

<footer class="gpi-footer" role="contentinfo">
  <div class="gpi-container">

    <div class="gpi-footer__top">
      <div class="gpi-footer__brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 200 }}"
               srcset="{{ section.settings.logo | image_url: width: 200 }} 1x, {{ section.settings.logo | image_url: width: 400 }} 2x"
               alt="{{ shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" loading="lazy">
        {%- else -%}
          <span class="gpi-footer__wordmark">{{ section.settings.wordmark | default: shop.name }}</span>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}<p class="gpi-footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
        {%- if section.settings.address != blank -%}<address class="gpi-footer__address">{{ section.settings.address }}</address>{%- endif -%}
      </div>

      <div class="gpi-footer__cols">
        {%- comment -%} Render menu-based link_column blocks first {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_column' -%}
            <div class="gpi-footer__col"{{ block.shopify_attributes }}>
              <h3 class="gpi-footer__col-heading">{{ block.settings.heading }}</h3>
              {%- if block.settings.menu != blank -%}
                {%- assign m = linklists[block.settings.menu] -%}
                <ul class="gpi-footer__col-list" role="list">
                  {%- for link in m.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Render the 4 inline-link columns from bucketed link_item blocks {%- endcomment -%}
        {%- assign cols = 'shop|Shop;about|About;help|Help;connect|Connect' | split: ';' -%}
        {%- for col_def in cols -%}
          {%- assign parts = col_def | split: '|' -%}
          {%- assign col_key   = parts[0] -%}
          {%- assign col_label = parts[1] -%}
          {%- case col_key -%}
            {%- when 'shop'    -%}{%- assign rows = cols_shop    | split: '||' -%}
            {%- when 'about'   -%}{%- assign rows = cols_about   | split: '||' -%}
            {%- when 'help'    -%}{%- assign rows = cols_help    | split: '||' -%}
            {%- when 'connect' -%}{%- assign rows = cols_connect | split: '||' -%}
          {%- endcase -%}
          {%- if rows.size > 0 -%}
            <div class="gpi-footer__col">
              <h3 class="gpi-footer__col-heading">{{ col_label }}</h3>
              <ul class="gpi-footer__col-list" role="list">
                {%- for row in rows -%}
                  {%- if row != '' -%}
                    {%- assign rp = row | split: '|' -%}
                    <li><a href="{{ rp[1] }}">{{ rp[0] }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="gpi-footer__newsletter">
        {%- render 'gpi-newsletter-form',
            heading: section.settings.newsletter_heading,
            lede: section.settings.newsletter_lede,
            placeholder: 'Your email',
            submit_label: 'Join the circle' -%}
        <div class="gpi-footer__currency-wrap">{%- render 'gpi-currency-switcher' -%}</div>
        {%- if section.settings.show_contact_quick -%}
          <ul class="gpi-footer__contact" role="list">
            {%- if section.settings.contact_phone != blank -%}
              <li>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.86 19.86 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.86 19.86 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' | replace: '+', '' | replace: '-', '' }}">{{ section.settings.contact_phone }}</a>
              </li>
            {%- endif -%}
            {%- if section.settings.contact_email != blank -%}
              <li>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
              </li>
            {%- endif -%}
            {%- if section.settings.contact_whatsapp != blank -%}
              <li>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M12 3a9 9 0 00-7.8 13.5L3 21l4.6-1.2A9 9 0 1012 3z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                <a href="https://wa.me/{{ section.settings.contact_whatsapp | replace: ' ', '' | replace: '+', '' | replace: '-', '' }}" target="_blank" rel="noopener">WhatsApp · {{ section.settings.contact_whatsapp }}</a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_trust_strip -%}
      <div class="gpi-footer__trust">{%- render 'gpi-trust-strip', variant: 'footer' -%}</div>
    {%- endif -%}

    <div class="gpi-footer__legal">
      <div class="gpi-footer__legal-left">
        <p class="gpi-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
        <ul class="gpi-footer__policy-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'policy_link' -%}
              <li{{ block.shopify_attributes }}><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div class="gpi-footer__legal-right">
        <ul class="gpi-footer__social" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social' -%}
              <li{{ block.shopify_attributes }}>
                <a href="{{ block.settings.url }}" aria-label="{{ block.settings.platform }}" rel="noopener" target="_blank">
                  {%- case block.settings.platform -%}
                    {%- when 'instagram' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                    {%- when 'facebook' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14 8h2V5h-2a3 3 0 00-3 3v2H9v3h2v8h3v-8h2.4l.6-3H14V8z" fill="currentColor"/></svg>
                    {%- when 'youtube' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 9l5 3-5 3z" fill="currentColor"/></svg>
                    {%- when 'whatsapp' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 00-7.8 13.5L3 21l4.6-1.2A9 9 0 1012 3z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                    {%- when 'pinterest' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M11 7c2 0 4 1.5 4 4s-1.5 4-3 4c-1 0-1.5-.5-1.5-1.5L11 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {%- else -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                  {%- endcase -%}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if section.settings.show_payment_icons -%}
          <ul class="gpi-footer__payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'gpi-footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "GPI Footer",
  "settings": [
    {"type": "image_picker", "id": "logo", "label": "Logo image (optional)"},
    {"type": "text", "id": "wordmark", "label": "Wordmark", "default": "GIFT PALACE"},
    {"type": "text", "id": "tagline", "label": "Tagline", "default": "Crafted in trust since 1989."},
    {"type": "textarea", "id": "address", "label": "Address", "default": "Chanakyapuri, New Delhi 110021\nIndia"},
    {"type": "header", "content": "Quick contact"},
    {"type": "checkbox", "id": "show_contact_quick", "label": "Show contact row in newsletter column", "default": true},
    {"type": "text", "id": "contact_phone", "label": "Phone", "default": "+91 70110 99721"},
    {"type": "text", "id": "contact_email", "label": "Email", "default": "support@giftpalaceindia.com"},
    {"type": "text", "id": "contact_whatsapp", "label": "WhatsApp", "default": "+91 70110 99721"},
    {"type": "header", "content": "Newsletter"},
    {"type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join the Gift Palace circle"},
    {"type": "text", "id": "newsletter_lede", "label": "Newsletter lede", "default": "Quiet emails on new arrivals, zodiac drops, and pieces our team is wearing."},
    {"type": "header", "content": "Strip & icons"},
    {"type": "checkbox", "id": "show_trust_strip", "label": "Show trust strip", "default": true},
    {"type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true},
    {"type": "header", "content": "Legal"},
    {"type": "text", "id": "copyright_text", "label": "Copyright suffix", "default": "All rights reserved."}
  ],
  "blocks": [
    {
      "type": "link_item",
      "name": "Direct link",
      "limit": 32,
      "settings": [
        {"type": "select", "id": "column", "label": "Column", "default": "shop",
          "options": [
            {"value": "shop", "label": "Shop"},
            {"value": "about", "label": "About"},
            {"value": "help", "label": "Help"},
            {"value": "connect", "label": "Connect"}
          ]
        },
        {"type": "text", "id": "label", "label": "Label"},
        {"type": "url", "id": "link", "label": "Link"}
      ]
    },
    {
      "type": "link_column",
      "name": "Menu-bound column (advanced)",
      "limit": 4,
      "settings": [
        {"type": "text", "id": "heading", "label": "Column heading"},
        {"type": "link_list", "id": "menu", "label": "Menu"}
      ]
    },
    {
      "type": "policy_link",
      "name": "Policy link",
      "limit": 6,
      "settings": [
        {"type": "text", "id": "label", "label": "Label"},
        {"type": "url", "id": "link", "label": "Link"}
      ]
    },
    {
      "type": "social",
      "name": "Social link",
      "limit": 6,
      "settings": [
        {"type": "select", "id": "platform", "label": "Platform", "default": "instagram",
          "options": [
            {"value": "instagram", "label": "Instagram"},
            {"value": "facebook", "label": "Facebook"},
            {"value": "youtube", "label": "YouTube"},
            {"value": "whatsapp", "label": "WhatsApp"},
            {"value": "pinterest", "label": "Pinterest"}
          ]
        },
        {"type": "url", "id": "url", "label": "URL"}
      ]
    }
  ],
  "presets": [
    {"name": "GPI Footer", "blocks": [
      {"type": "link_item", "settings": {"column": "shop", "label": "All collections", "link": "/collections"}},
      {"type": "link_item", "settings": {"column": "shop", "label": "Necklaces", "link": "/collections/necklaces"}},
      {"type": "link_item", "settings": {"column": "shop", "label": "Bracelets", "link": "/collections/bracelets"}},
      {"type": "link_item", "settings": {"column": "shop", "label": "Rings", "link": "/collections/rings"}},
      {"type": "link_item", "settings": {"column": "shop", "label": "Loose gemstones", "link": "/collections/gemstones"}},
      {"type": "link_item", "settings": {"column": "shop", "label": "Raw crystals", "link": "/collections/raw-crystals"}},
      {"type": "link_item", "settings": {"column": "shop", "label": "Mala", "link": "/collections/jaap-mala"}},
      {"type": "link_item", "settings": {"column": "shop", "label": "Gift sets", "link": "/collections/gift-sets"}},

      {"type": "link_item", "settings": {"column": "about", "label": "Our story", "link": "/pages/about-us"}},
      {"type": "link_item", "settings": {"column": "about", "label": "Our atelier", "link": "/pages/about-us"}},
      {"type": "link_item", "settings": {"column": "about", "label": "Certifications", "link": "/pages/certifications"}},
      {"type": "link_item", "settings": {"column": "about", "label": "Healing crystals guide", "link": "/pages/healing-crystals-guide"}},
      {"type": "link_item", "settings": {"column": "about", "label": "Shop by intention", "link": "/pages/shop-by-intention"}},
      {"type": "link_item", "settings": {"column": "about", "label": "Journal", "link": "/blogs/news"}},

      {"type": "link_item", "settings": {"column": "help", "label": "Contact us", "link": "/pages/contact-us"}},
      {"type": "link_item", "settings": {"column": "help", "label": "FAQs", "link": "/pages/faqs"}},
      {"type": "link_item", "settings": {"column": "help", "label": "Shipping policy", "link": "/policies/shipping-policy"}},
      {"type": "link_item", "settings": {"column": "help", "label": "Refunds & returns", "link": "/policies/refund-policy"}},
      {"type": "link_item", "settings": {"column": "help", "label": "Ring size guide", "link": "/pages/ring-size-guide"}},
      {"type": "link_item", "settings": {"column": "help", "label": "Care instructions", "link": "/pages/care-instructions"}},
      {"type": "link_item", "settings": {"column": "help", "label": "Track your order", "link": "/account"}},

      {"type": "link_item", "settings": {"column": "connect", "label": "Visit the store", "link": "/pages/store-locator"}},
      {"type": "link_item", "settings": {"column": "connect", "label": "Book a private viewing", "link": "/pages/contact-us"}},
      {"type": "link_item", "settings": {"column": "connect", "label": "Wholesale enquiries", "link": "/pages/contact-us"}},
      {"type": "link_item", "settings": {"column": "connect", "label": "Custom commissions", "link": "/pages/contact-us"}},
      {"type": "link_item", "settings": {"column": "connect", "label": "My account", "link": "/account"}},
      {"type": "link_item", "settings": {"column": "connect", "label": "Wishlist", "link": "/pages/wishlist"}},

      {"type": "policy_link", "settings": {"label": "Privacy Policy", "link": "/policies/privacy-policy"}},
      {"type": "policy_link", "settings": {"label": "Terms of Service", "link": "/policies/terms-of-service"}},
      {"type": "policy_link", "settings": {"label": "Shipping", "link": "/policies/shipping-policy"}},
      {"type": "policy_link", "settings": {"label": "Refunds", "link": "/policies/refund-policy"}},
      {"type": "policy_link", "settings": {"label": "Accessibility", "link": "/pages/accessibility"}},

      {"type": "social", "settings": {"platform": "instagram"}},
      {"type": "social", "settings": {"platform": "facebook"}},
      {"type": "social", "settings": {"platform": "whatsapp"}},
      {"type": "social", "settings": {"platform": "youtube"}}
    ]}
  ]
}
{% endschema %}
