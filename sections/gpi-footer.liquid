{%- comment -%} Section: gpi-footer — 4-column grid + newsletter + trust strip + currency + social + legal {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-footer.css' | asset_url }}">

<footer class="gpi-footer" role="contentinfo">
  <div class="gpi-container">

    <div class="gpi-footer__top">
      <div class="gpi-footer__brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 200 }}"
               srcset="{{ section.settings.logo | image_url: width: 200 }} 1x, {{ section.settings.logo | image_url: width: 400 }} 2x"
               alt="{{ shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" loading="lazy">
        {%- else -%}
          <span class="gpi-footer__wordmark">{{ section.settings.wordmark | default: shop.name }}</span>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}<p class="gpi-footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
        {%- if section.settings.address != blank -%}<address class="gpi-footer__address">{{ section.settings.address }}</address>{%- endif -%}
      </div>

      <div class="gpi-footer__cols">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_column' -%}
            <div class="gpi-footer__col"{{ block.shopify_attributes }}>
              <h3 class="gpi-footer__col-heading">{{ block.settings.heading }}</h3>
              {%- if block.settings.menu != blank -%}
                {%- assign m = linklists[block.settings.menu] -%}
                <ul class="gpi-footer__col-list" role="list">
                  {%- for link in m.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="gpi-footer__newsletter">
        {%- render 'gpi-newsletter-form',
            heading: section.settings.newsletter_heading,
            lede: section.settings.newsletter_lede,
            placeholder: 'Your email',
            submit_label: 'Join the circle' -%}
        <div class="gpi-footer__currency-wrap">{%- render 'gpi-currency-switcher' -%}</div>
      </div>
    </div>

    {%- if section.settings.show_trust_strip -%}
      <div class="gpi-footer__trust">{%- render 'gpi-trust-strip', variant: 'footer' -%}</div>
    {%- endif -%}

    <div class="gpi-footer__legal">
      <div class="gpi-footer__legal-left">
        <p class="gpi-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
        <ul class="gpi-footer__policy-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'policy_link' -%}
              <li{{ block.shopify_attributes }}><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div class="gpi-footer__legal-right">
        <ul class="gpi-footer__social" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social' -%}
              <li{{ block.shopify_attributes }}>
                <a href="{{ block.settings.url }}" aria-label="{{ block.settings.platform }}" rel="noopener" target="_blank">
                  {%- case block.settings.platform -%}
                    {%- when 'instagram' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                    {%- when 'facebook' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14 8h2V5h-2a3 3 0 00-3 3v2H9v3h2v8h3v-8h2.4l.6-3H14V8z" fill="currentColor"/></svg>
                    {%- when 'youtube' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 9l5 3-5 3z" fill="currentColor"/></svg>
                    {%- when 'whatsapp' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 00-7.8 13.5L3 21l4.6-1.2A9 9 0 1012 3z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                    {%- when 'pinterest' -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M11 7c2 0 4 1.5 4 4s-1.5 4-3 4c-1 0-1.5-.5-1.5-1.5L11 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {%- else -%}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                  {%- endcase -%}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if section.settings.show_payment_icons -%}
          <ul class="gpi-footer__payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'gpi-footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "GPI Footer",
  "settings": [
    {"type": "image_picker", "id": "logo", "label": "Logo image (optional)"},
    {"type": "text", "id": "wordmark", "label": "Wordmark", "default": "GIFT PALACE"},
    {"type": "text", "id": "tagline", "label": "Tagline", "default": "Crafted in trust since 1989."},
    {"type": "textarea", "id": "address", "label": "Address"},
    {"type": "header", "content": "Newsletter"},
    {"type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join the Gift Palace circle"},
    {"type": "text", "id": "newsletter_lede", "label": "Newsletter lede", "default": "Quiet emails on new arrivals, zodiac drops, and pieces our team is wearing."},
    {"type": "header", "content": "Strip & icons"},
    {"type": "checkbox", "id": "show_trust_strip", "label": "Show trust strip", "default": true},
    {"type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true},
    {"type": "header", "content": "Legal"},
    {"type": "text", "id": "copyright_text", "label": "Copyright suffix", "default": "All rights reserved."}
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        {"type": "text", "id": "heading", "label": "Column heading"},
        {"type": "link_list", "id": "menu", "label": "Menu"}
      ]
    },
    {
      "type": "policy_link",
      "name": "Policy link",
      "limit": 6,
      "settings": [
        {"type": "text", "id": "label", "label": "Label"},
        {"type": "url", "id": "link", "label": "Link"}
      ]
    },
    {
      "type": "social",
      "name": "Social link",
      "limit": 6,
      "settings": [
        {"type": "select", "id": "platform", "label": "Platform", "default": "instagram",
          "options": [
            {"value": "instagram", "label": "Instagram"},
            {"value": "facebook", "label": "Facebook"},
            {"value": "youtube", "label": "YouTube"},
            {"value": "whatsapp", "label": "WhatsApp"},
            {"value": "pinterest", "label": "Pinterest"}
          ]
        },
        {"type": "url", "id": "url", "label": "URL"}
      ]
    }
  ],
  "presets": [
    {"name": "GPI Footer", "blocks": [
      {"type": "link_column", "settings": {"heading": "Shop"}},
      {"type": "link_column", "settings": {"heading": "About"}},
      {"type": "link_column", "settings": {"heading": "Help"}},
      {"type": "link_column", "settings": {"heading": "Connect"}},
      {"type": "policy_link", "settings": {"label": "Privacy Policy", "link": "/policies/privacy-policy"}},
      {"type": "policy_link", "settings": {"label": "Terms of Service", "link": "/policies/terms-of-service"}},
      {"type": "policy_link", "settings": {"label": "Shipping Policy", "link": "/policies/shipping-policy"}},
      {"type": "policy_link", "settings": {"label": "Refund Policy", "link": "/policies/refund-policy"}},
      {"type": "social", "settings": {"platform": "instagram"}},
      {"type": "social", "settings": {"platform": "facebook"}},
      {"type": "social", "settings": {"platform": "whatsapp"}}
    ]}
  ]
}
{% endschema %}
