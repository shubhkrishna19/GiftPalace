{%- comment -%} Section: gpi-password — coming-soon landing {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-edge.css' | asset_url }}">

<section class="gpi-password">
  {%- if section.settings.bg_image -%}
    {%- render 'gpi-image', image: section.settings.bg_image, alt: '', sizes: '100vw', loading: 'eager', class: 'gpi-password__bg' -%}
    <div class="gpi-password__overlay"></div>
  {%- else -%}
    <img src="{{ 'gpi-password-bg.webp' | asset_url }}" alt="" class="gpi-password__bg" width="1376" height="768" loading="eager">
    <div class="gpi-password__overlay"></div>
  {%- endif -%}

  <div class="gpi-container gpi-password__inner">
    <div class="gpi-password__brand">
      {%- if shop.brand.logo -%}
        <img src="{{ shop.brand.logo | image_url: width: 240 }}" alt="{{ shop.name }}" width="240" height="60">
      {%- else -%}
        <span class="gpi-password__wordmark">GIFT PALACE</span>
      {%- endif -%}
    </div>
    <h1>{{ section.settings.title | default: 'Something beautiful is coming.' }}</h1>
    <p class="gpi-password__lede">{{ section.settings.lede | default: 'Our doors open soon. Leave your email and be the first to step in.' }}</p>

    <div class="gpi-password__newsletter">
      {%- render 'gpi-newsletter-form', placeholder: 'Your email', submit_label: 'Notify me' -%}
    </div>

    <details class="gpi-password__owner">
      <summary>Owner login</summary>
      {% form 'storefront_password', class: 'gpi-customer__form' %}
        {% if form.errors %}<div class="gpi-customer__errors">{{ form.errors | default_errors }}</div>{% endif %}
        <div class="gpi-customer__field"><label for="StorefrontPassword">Password</label><input id="StorefrontPassword" type="password" name="password"></div>
        <button type="submit" class="gpi-button gpi-button--primary gpi-button--md">Enter</button>
      {% endform %}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "GPI Password",
  "settings": [
    {"type": "text", "id": "title", "label": "Heading", "default": "Something beautiful is coming."},
    {"type": "textarea", "id": "lede", "label": "Body"},
    {"type": "image_picker", "id": "bg_image", "label": "Background image"}
  ],
  "presets": [{"name": "GPI Password"}]
}
{% endschema %}
