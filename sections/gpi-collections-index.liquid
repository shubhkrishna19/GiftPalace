{%- comment -%} Section: gpi-collections-index — list of all collections {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-page.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-collection.css' | asset_url }}">

<article class="gpi-collections-index">
  <header class="gpi-collection-hero">
    <div class="gpi-container gpi-collection-hero__inner">
      {%- render 'gpi-breadcrumbs' -%}
      <p class="gpi-collection-hero__eyebrow">{{ section.settings.eyebrow | default: 'All collections' }}</p>
      <h1 class="gpi-collection-hero__title">{{ section.settings.title | default: 'Browse every collection' }}</h1>
      {%- if section.settings.lede != blank -%}<p class="gpi-collection-hero__lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
  </header>

  <section class="gpi-collections-index__grid-wrap gpi-section">
    <div class="gpi-container">
      <ul class="gpi-collections-index__grid" role="list">
        {%- for coll in collections -%}
          {%- if coll.products_count > 0 -%}
            <li>
              <a class="gpi-collections-index__card" href="{{ coll.url }}">
                <div class="gpi-collections-index__media">
                  {%- if coll.image -%}{%- render 'gpi-image', image: coll.image, alt: coll.title, sizes: '320px', loading: 'lazy' -%}
                  {%- elsif coll.products.first.featured_image -%}{%- render 'gpi-image', image: coll.products.first.featured_image, alt: coll.title, sizes: '320px', loading: 'lazy' -%}
                  {%- endif -%}
                </div>
                <h2>{{ coll.title }}</h2>
                <p>{{ coll.products_count }} {{ coll.products_count | pluralize: 'piece', 'pieces' }}</p>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
</article>

<style>
.gpi-collections-index__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.gpi-collections-index__card { display: block; text-decoration: none; color: var(--gpi-ink-strong); background: var(--gpi-surface-card); border-radius: var(--gpi-radius-card); overflow: hidden; transition: box-shadow var(--gpi-transition); }
.gpi-collections-index__card:hover { box-shadow: var(--gpi-shadow-mid); }
.gpi-collections-index__media { aspect-ratio: 4/3; overflow: hidden; background: var(--gpi-surface-ivory); }
.gpi-collections-index__media img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--gpi-transition-slow); }
.gpi-collections-index__card:hover img { transform: scale(1.04); }
.gpi-collections-index__card h2 { font-family: var(--gpi-heading); font-size: 20px; margin: 16px 16px 4px; color: var(--gpi-ink-strong); }
.gpi-collections-index__card p { margin: 0 16px 16px; font-size: 12px; color: var(--gpi-text-muted); letter-spacing: 0.04em; }
@media (max-width: 1024px) { .gpi-collections-index__grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .gpi-collections-index__grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "GPI Collections index",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "All collections"},
    {"type": "text", "id": "title", "label": "Title", "default": "Browse every collection"},
    {"type": "textarea", "id": "lede", "label": "Lede"}
  ],
  "presets": [{"name": "GPI Collections index"}]
}
{% endschema %}
