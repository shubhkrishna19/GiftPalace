{%- comment -%}
  Conversion-Focused Intro Section
  Two-column layout: persuasive copy (left) + rich media carousel (right)
  Responsive collapse: 2-column at desktop → stacked at mobile
  Enhanced with design tokens, dark mode, carousel interactions
{%- endcomment -%}

<style media="not all" data-gpi-retired-inline>
  /* Design system tokens for conversion section */
  :root {
    --color-primary: #d4af37;
    --color-surface: #fafafa;
    --color-text: #1a1a1a;
    --color-text-muted: #666;
    --color-border: #e5e5e5;
    --color-accent: #f0e6d2;
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 3rem;
    --space-xl: 4rem;
    --shadow-sm: 0 2px 8px rgba(212, 175, 55, 0.08);
    --shadow-md: 0 4px 16px rgba(212, 175, 55, 0.12);
    --shadow-lg: 0 8px 24px rgba(212, 175, 55, 0.15);
    --shadow-xl: 0 20px 48px rgba(212, 175, 55, 0.25);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --duration-normal: 300ms;
    --duration-slow: 500ms;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home-conversion-intro {
    background: linear-gradient(180deg, var(--color-surface, #fafafa) 0%, rgba(212, 175, 55, 0.01) 100%);
    color: var(--color-text, #1a1a1a);
    padding: clamp(3rem, 5vw, 6rem) clamp(1rem, 4vw, 3rem);
    position: relative;
    overflow: hidden;
  }

  .home-conversion-intro::before {
    content: '';
    position: absolute;
    bottom: -50%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.05) 0%, rgba(212, 175, 55, 0.01) 100%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .home-conversion-intro > * {
    position: relative;
    z-index: 1;
  }

  /* Main container with two-column layout */
  .home-conversion-intro__wrapper {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 4vw, 5rem);
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Left column: persuasive copy */
  .home-conversion-intro__content {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2vw, 2.5rem);
  }

  .home-conversion-intro__eyebrow {
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary, #d4af37);
    margin: 0;
  }

  .home-conversion-intro__heading {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--color-text, #1a1a1a);
    letter-spacing: -0.01em;
  }

  .home-conversion-intro__subheading {
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-text-muted, #666);
    margin: 0;
    max-width: 550px;
  }

  .home-conversion-intro__description {
    font-size: clamp(0.95rem, 1.1vw, 1rem);
    line-height: 1.8;
    color: var(--color-text-muted, #666);
    margin: 0;
    max-width: 550px;
  }

  /* Benefits/Features list */
  .home-conversion-intro__benefits {
    display: flex;
    flex-direction: column;
    gap: var(--space-md, 1.5rem);
    margin: var(--space-md, 1.5rem) 0;
  }

  .home-conversion-intro__benefit-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm, 1rem);
    padding: var(--space-sm, 1rem) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.1);
  }

  .home-conversion-intro__benefit-item:last-child {
    border-bottom: none;
  }

  .home-conversion-intro__benefit-icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    color: var(--color-primary, #d4af37);
    flex-shrink: 0;
    margin-top: 4px;
  }

  .home-conversion-intro__benefit-text {
    font-size: clamp(0.95rem, 1vw, 1rem);
    font-weight: 500;
    color: var(--color-text, #1a1a1a);
    line-height: 1.5;
  }

  /* CTA button */
  .home-conversion-intro__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.875rem, 1.25vw, 1.125rem) clamp(1.75rem, 2.5vw, 2.5rem);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    font-weight: 600;
    color: white;
    background: var(--color-primary, #d4af37);
    text-decoration: none;
    border-radius: var(--radius-sm, 8px);
    transition: all var(--duration-normal, 300ms) var(--ease-out-expo);
    border: 2px solid var(--color-primary, #d4af37);
    cursor: pointer;
    width: fit-content;
    box-shadow: var(--shadow-md, 0 4px 16px rgba(212, 175, 55, 0.12));
  }

  .home-conversion-intro__cta:hover {
    background: #c99f37;
    border-color: #c99f37;
    box-shadow: var(--shadow-lg, 0 8px 24px rgba(212, 175, 55, 0.15));
    transform: translateY(-2px);
  }

  .home-conversion-intro__cta:focus-visible {
    outline: 2px solid var(--color-primary, #d4af37);
    outline-offset: 4px;
  }

  /* Right column: media carousel */
  .home-conversion-intro__media-container {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-md, 1.5rem);
  }

  /* Carousel wrapper */
  .home-conversion-intro__carousel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-xl, 0 20px 48px rgba(212, 175, 55, 0.25));
    background: white;
    aspect-ratio: 1 / 1;
  }

  .home-conversion-intro__carousel-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    transition: transform var(--duration-slow, 500ms) var(--ease-out-expo);
  }

  .home-conversion-intro__carousel-slide {
    min-width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface, #fafafa);
    overflow: hidden;
    position: relative;
  }

  .home-conversion-intro__carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow, 500ms) var(--ease-out-expo);
  }

  .home-conversion-intro__carousel-slide:hover .home-conversion-intro__carousel-image {
    transform: scale(1.05);
  }

  /* Carousel controls */
  .home-conversion-intro__carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm, 1rem);
    padding: var(--space-md, 1.5rem);
  }

  .home-conversion-intro__carousel-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(212, 175, 55, 0.3);
    cursor: pointer;
    transition: all var(--duration-normal, 300ms) var(--ease-out-expo);
    border: 2px solid transparent;
  }

  .home-conversion-intro__carousel-dot.active {
    background: var(--color-primary, #d4af37);
    transform: scale(1.2);
  }

  .home-conversion-intro__carousel-dot:hover {
    background: var(--color-primary, #d4af37);
    border-color: rgba(212, 175, 55, 0.3);
  }

  .home-conversion-intro__carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(40px, 5vw, 56px);
    height: clamp(40px, 5vw, 56px);
    background: rgba(212, 175, 55, 0.9);
    border: none;
    color: white;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    cursor: pointer;
    border-radius: var(--radius-sm, 8px);
    transition: all var(--duration-normal, 300ms) var(--ease-out-expo);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .home-conversion-intro__carousel-arrow:hover {
    background: var(--color-primary, #d4af37);
    box-shadow: var(--shadow-md, 0 4px 16px rgba(212, 175, 55, 0.12));
    transform: translateY(-50%) scale(1.1);
  }

  .home-conversion-intro__carousel-arrow:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  .home-conversion-intro__carousel-arrow.prev {
    left: var(--space-md, 1.5rem);
  }

  .home-conversion-intro__carousel-arrow.next {
    right: var(--space-md, 1.5rem);
  }

  /* Media thumbnails */
  .home-conversion-intro__thumbnails {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: var(--space-sm, 1rem);
  }

  .home-conversion-intro__thumbnail {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm, 8px);
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all var(--duration-normal, 300ms) var(--ease-out-expo);
    background: var(--color-accent, #f0e6d2);
  }

  .home-conversion-intro__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-normal, 300ms) var(--ease-out-expo);
  }

  .home-conversion-intro__thumbnail:hover img {
    transform: scale(1.1);
  }

  .home-conversion-intro__thumbnail.active {
    border-color: var(--color-primary, #d4af37);
    box-shadow: var(--shadow-md, 0 4px 16px rgba(212, 175, 55, 0.12));
  }

  /* Tablet Breakpoint */
  @media (max-width: 1024px) {
    .home-conversion-intro__wrapper {
      grid-template-columns: 1fr;
      gap: clamp(2rem, 3vw, 3rem);
    }

    .home-conversion-intro__content {
      order: 2;
    }

    .home-conversion-intro__media-container {
      order: 1;
      max-width: 100%;
    }

    .home-conversion-intro__carousel {
      aspect-ratio: 16 / 9;
    }
  }

  /* Mobile Breakpoint */
  @media (max-width: 640px) {
    .home-conversion-intro {
      padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 3vw, 1.5rem);
    }

    .home-conversion-intro::before {
      width: 300px;
      height: 300px;
      bottom: -20%;
      left: -15%;
      opacity: 0.3;
    }

    .home-conversion-intro__wrapper {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2rem);
    }

    .home-conversion-intro__carousel {
      aspect-ratio: 1 / 1;
    }

    .home-conversion-intro__carousel-arrow {
      width: 40px;
      height: 40px;
      font-size: 1.125rem;
    }

    .home-conversion-intro__carousel-arrow.prev {
      left: var(--space-sm, 1rem);
    }

    .home-conversion-intro__carousel-arrow.next {
      right: var(--space-sm, 1rem);
    }

    .home-conversion-intro__thumbnails {
      grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
      gap: var(--space-xs, 0.5rem);
    }

    .home-conversion-intro__benefit-item {
      padding: var(--space-sm, 1rem) 0;
    }
  }

  /* Dark Mode Support */
  @media (prefers-color-scheme: dark) {
    .home-conversion-intro {
      background: linear-gradient(180deg, #1a1a1a 0%, rgba(212, 175, 55, 0.02) 100%);
      color: #f5f5f5;
    }

    .home-conversion-intro::before {
      background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, rgba(212, 175, 55, 0.02) 100%);
    }

    .home-conversion-intro__heading {
      color: #f5f5f5;
    }

    .home-conversion-intro__subheading,
    .home-conversion-intro__description {
      color: #b0b0b0;
    }

    .home-conversion-intro__benefit-item {
      border-bottom-color: rgba(212, 175, 55, 0.15);
    }

    .home-conversion-intro__benefit-text {
      color: #f5f5f5;
    }

    .home-conversion-intro__carousel {
      background: #2a2a2a;
    }

    .home-conversion-intro__carousel-slide {
      background: #2a2a2a;
    }

    .home-conversion-intro__carousel-dot {
      background: rgba(212, 175, 55, 0.2);
    }

    .home-conversion-intro__thumbnail {
      background: #3a3a3a;
      border-color: transparent;
    }

    .home-conversion-intro__thumbnail.active {
      border-color: var(--color-primary, #d4af37);
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .home-conversion-intro__carousel-inner,
    .home-conversion-intro__carousel-image,
    .home-conversion-intro__carousel-dot,
    .home-conversion-intro__carousel-arrow,
    .home-conversion-intro__thumbnail img,
    .home-conversion-intro__cta {
      transition: none;
    }

    .home-conversion-intro__carousel-slide:hover .home-conversion-intro__carousel-image {
      transform: none;
    }

    .home-conversion-intro__carousel-arrow:hover {
      transform: translateY(-50%);
    }

    .home-conversion-intro__cta:hover {
      transform: none;
    }

    .home-conversion-intro__thumbnail:hover img {
      transform: none;
    }
  }
</style>

<div class="home-conversion-intro section-block-{{ section.id }}">
  <div class="{% if section.settings.container == 'fullwidth' %}container-full{% elsif section.settings.container == '1770' %}container-1770{% elsif section.settings.container == '1170' %}container-1170{% else %}container{% endif %}">
    <div class="home-conversion-intro__wrapper">
      
      <!-- Left Column: Persuasive Copy -->
      <div class="home-conversion-intro__content">
        {% if section.settings.eyebrow != blank %}
          <p class="home-conversion-intro__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        
        {% if section.settings.heading != blank %}
          <h2 class="home-conversion-intro__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        
        {% if section.settings.subheading != blank %}
          <p class="home-conversion-intro__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
        
        {% if section.settings.description != blank %}
          <p class="home-conversion-intro__description">{{ section.settings.description }}</p>
        {% endif %}

        <!-- Benefits List -->
        {% if section.blocks.size > 0 %}
          <div class="home-conversion-intro__benefits">
            {% for block in section.blocks %}
              {% if block.type == 'benefit' %}
                <div class="home-conversion-intro__benefit-item" {{ block.shopify_attributes }}>
                  {% if block.settings.benefit_icon %}
                    <div class="home-conversion-intro__benefit-icon">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </div>
                  {% endif %}
                  <p class="home-conversion-intro__benefit-text">{{ block.settings.benefit_text }}</p>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        
        {% if section.settings.cta_text and section.settings.cta_link %}
          <a href="{{ section.settings.cta_link }}" class="home-conversion-intro__cta">
            {{ section.settings.cta_text }}
          </a>
        {% endif %}
      </div>

      <!-- Right Column: Media Carousel -->
      <div class="home-conversion-intro__media-container">
        <div class="home-conversion-intro__carousel" aria-label="Product showcase carousel">
          <div class="home-conversion-intro__carousel-inner" id="carousel-inner-{{ section.id }}">
            {% assign media_blocks = section.blocks | where: 'type', 'media_slide' %}
            {% for block in media_blocks %}
              <div class="home-conversion-intro__carousel-slide" {{ block.shopify_attributes }}>
                {% if block.settings.media_image %}
                  <img 
                    src="{{ block.settings.media_image | image_url: width: 600 }}"
                    alt="{{ block.settings.media_image.alt | escape }}"
                    class="home-conversion-intro__carousel-image"
                    loading="lazy"
                    width="600"
                    height="600"
                  />
                {% endif %}
              </div>
            {% endfor %}
          </div>

          {% if media_blocks.size > 1 %}
            <button class="home-conversion-intro__carousel-arrow prev" aria-label="Previous slide">←</button>
            <button class="home-conversion-intro__carousel-arrow next" aria-label="Next slide">→</button>
          {% endif %}
        </div>

        <!-- Thumbnails for quick navigation -->
        {% if media_blocks.size > 1 %}
          <div class="home-conversion-intro__thumbnails" id="thumbnails-{{ section.id }}">
            {% for block in media_blocks %}
              <button 
                class="home-conversion-intro__thumbnail {% if forloop.first %}active{% endif %}" 
                aria-label="Slide {{ forloop.index }}"
                data-index="{{ forloop.index0 }}"
              >
                {% if block.settings.media_image %}
                  <img 
                    src="{{ block.settings.media_image | image_url: width: 80 }}"
                    alt=""
                    width="80"
                    height="80"
                  />
                {% endif %}
              </button>
            {% endfor %}
          </div>

          <!-- Carousel indicators -->
          <div class="home-conversion-intro__carousel-controls" id="carousel-dots-{{ section.id }}">
            {% for block in media_blocks %}
              <button 
                class="home-conversion-intro__carousel-dot {% if forloop.first %}active{% endif %}"
                aria-label="Go to slide {{ forloop.index }}"
                data-index="{{ forloop.index0 }}"
              ></button>
            {% endfor %}
          </div>

          <script>
            (function() {
              const carouselId = '{{ section.id }}';
              const inner = document.getElementById('carousel-inner-' + carouselId);
              const dots = document.querySelectorAll('#carousel-dots-' + carouselId + ' .home-conversion-intro__carousel-dot');
              const thumbnails = document.querySelectorAll('#thumbnails-' + carouselId + ' .home-conversion-intro__thumbnail');
              const prevBtn = document.querySelector('.carousel-inner-' + carouselId + ' .prev');
              const nextBtn = document.querySelector('.carousel-inner-' + carouselId + ' .next');
              
              let currentIndex = 0;
              const totalSlides = dots.length;

              function goToSlide(index) {
                currentIndex = (index + totalSlides) % totalSlides;
                inner.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
                
                dots.forEach((dot, i) => {
                  dot.classList.toggle('active', i === currentIndex);
                });
                
                thumbnails.forEach((thumb, i) => {
                  thumb.classList.toggle('active', i === currentIndex);
                });
              }

              dots.forEach((dot, i) => {
                dot.addEventListener('click', () => goToSlide(i));
              });

              thumbnails.forEach((thumb, i) => {
                thumb.addEventListener('click', () => goToSlide(i));
              });

              document.addEventListener('click', (e) => {
                if (e.target.closest('.home-conversion-intro__carousel-arrow.prev')) {
                  goToSlide(currentIndex - 1);
                }
                if (e.target.closest('.home-conversion-intro__carousel-arrow.next')) {
                  goToSlide(currentIndex + 1);
                }
              });
            })();
          </script>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Conversion Intro Plus",
  "tag": "section",
  "class": "section-home-conversion-intro",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "1770",
      "options": [
        { "value": "container", "label": "Standard" },
        { "value": "1170", "label": "1170px" },
        { "value": "1770", "label": "1770px" },
        { "value": "fullwidth", "label": "Full width" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium Experience"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Authentic Gemstones"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "GJEPC-certified gemstones sourced with expertise and care"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Each gemstone in our collection undergoes rigorous laboratory testing and authentic documentation. Experience the difference that true certification brings to your jewelry investment."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "limit": 4,
      "settings": [
        {
          "type": "checkbox",
          "id": "benefit_icon",
          "label": "Show checkmark icon",
          "default": true
        },
        {
          "type": "text",
          "id": "benefit_text",
          "label": "Benefit text",
          "default": "GJEPC Lab-Tested Authenticity"
        }
      ]
    },
    {
      "type": "media_slide",
      "name": "Media Slide",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "media_image",
          "label": "Slide image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Conversion Intro Plus",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "benefit_icon": true,
            "benefit_text": "GJEPC Lab-Tested Authenticity"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "benefit_icon": true,
            "benefit_text": "35+ Years of Heritage & Trust"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "benefit_icon": true,
            "benefit_text": "WhatsApp Support & Guidance"
          }
        },
        {
          "type": "media_slide"
        },
        {
          "type": "media_slide"
        }
      ]
    }
  ]
}
{% endschema %}
