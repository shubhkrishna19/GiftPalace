{%- comment -%} Section: gpi-404 — Not Found page {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-edge.css' | asset_url }}">

<section class="gpi-404" style="background-image: linear-gradient(rgba(255,253,248,0.82), rgba(255,253,248,0.94)), url('{{ 'gpi-404-bg.webp' | asset_url }}'); background-size: cover; background-position: center;">
  <div class="gpi-container gpi-404__inner">
    <p class="gpi-eyebrow">404</p>
    <h1>{{ section.settings.title | default: 'We lost the gem you were looking for.' }}</h1>
    <p class="gpi-404__lede">{{ section.settings.lede | default: 'The page you opened has moved or never existed. Here are a few places to start instead.' }}</p>

    <form action="{{ routes.search_url }}" method="get" role="search" class="gpi-404__search">
      <input type="search" name="q" placeholder="Search the store…" autocomplete="off">
      <button type="submit" class="gpi-button gpi-button--primary gpi-button--md">Search</button>
    </form>

    <div class="gpi-404__cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'shortcut' -%}
          {%- assign coll = collections[block.settings.collection] -%}
          <a class="gpi-404__card" href="{{ coll.url | default: block.settings.link }}"{{ block.shopify_attributes }}>
            {%- if coll.image -%}{%- render 'gpi-image', image: coll.image, alt: coll.title, sizes: '320px', loading: 'lazy' -%}{%- endif -%}
            <span>{{ block.settings.label | default: coll.title }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <a href="{{ routes.root_url }}" class="gpi-button gpi-button--text">← Back to home</a>
  </div>
</section>

{% schema %}
{
  "name": "GPI 404",
  "settings": [
    {"type": "text", "id": "title", "label": "Heading", "default": "We lost the gem you were looking for."},
    {"type": "textarea", "id": "lede", "label": "Body"}
  ],
  "blocks": [
    {"type": "shortcut", "name": "Shortcut card", "limit": 6, "settings": [
      {"type": "collection", "id": "collection", "label": "Collection"},
      {"type": "text", "id": "label", "label": "Fallback label"},
      {"type": "url", "id": "link", "label": "Fallback link"}
    ]}
  ],
  "presets": [{"name": "GPI 404", "blocks": [
    {"type": "shortcut", "settings": {"label": "Necklaces"}},
    {"type": "shortcut", "settings": {"label": "Bracelets"}},
    {"type": "shortcut", "settings": {"label": "Rings"}}
  ]}]
}
{% endschema %}
