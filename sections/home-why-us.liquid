{%- comment -%} Section: home-why-us - Compact value props for premium gemstone buying confidence {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-home-why-us.css' | asset_url }}">

<section class="home-why-us" aria-labelledby="home-why-us-heading">
  <div class="home-why-us__header">
    {% if section.settings.eyebrow != blank %}
      <p class="home-why-us__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.title != blank %}
      <h2 id="home-why-us-heading" class="home-why-us__title">{{ section.settings.title | escape }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="home-why-us__subheading">{{ section.settings.subheading | escape }}</p>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="home-why-us__grid">
      {% for block in section.blocks %}
        <article class="home-why-us__card" {{ block.shopify_attributes }}>
          <div class="home-why-us__icon" aria-hidden="true">
            {% if block.settings.svg_code != blank %}
              {{ block.settings.svg_code }}
            {% elsif block.settings.icon_name == 'certificate' %}
              <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M8 3h8l2 4 4 2v8l-4 2-2 4H8l-2-4-4-2V9l4-2 2-4Z"/><path d="m8.5 12 2.25 2.25L15.75 9"/></svg>
            {% elsif block.settings.icon_name == 'consultation' %}
              <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M4 5h16v10H8l-4 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>
            {% elsif block.settings.icon_name == 'shipping' %}
              <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M3 6h11v10H3V6Z"/><path d="M14 10h4l3 3v3h-7v-6Z"/><path d="M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
            {% elsif block.settings.icon_name == 'craft' %}
              <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M12 3 4 8l8 13 8-13-8-5Z"/><path d="M4 8h16M9 8l3 13 3-13"/></svg>
            {% elsif block.settings.icon_name == 'support' %}
              <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M12 4a8 8 0 0 0-8 8v3a3 3 0 0 0 3 3h1v-6H6a6 6 0 0 1 12 0h-2v6h1a3 3 0 0 0 3-3v-3a8 8 0 0 0-8-8Z"/><path d="M10 20h4"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" focusable="false"><path d="M20 6 9 17l-5-5"/></svg>
            {% endif %}
          </div>

          {% if block.settings.heading != blank %}
            <h3 class="home-why-us__card-title">{{ block.settings.heading | escape }}</h3>
          {% endif %}

          {% if block.settings.body != blank %}
            <p class="home-why-us__card-body">{{ block.settings.body | escape }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Why Buy From Us",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Gift Palace"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Built for confident gemstone buying."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "From certification to human guidance, every detail is designed to help you choose with clarity."
    }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Value prop",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "certificate", "label": "Certificate" },
            { "value": "consultation", "label": "Consultation" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "craft", "label": "Craft" },
            { "value": "support", "label": "Support" }
          ],
          "default": "check"
        },
        {
          "type": "textarea",
          "id": "svg_code",
          "label": "Custom SVG code",
          "info": "Optional. Overrides the selected icon."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Certified natural gemstones"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Shop pieces selected for authenticity, clarity, and everyday wear."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Buy From Us",
      "blocks": [
        {
          "type": "prop",
          "settings": {
            "icon_name": "certificate",
            "heading": "Certified natural gemstones",
            "body": "Every important piece is backed by authenticity-led sourcing and careful inspection."
          }
        },
        {
          "type": "prop",
          "settings": {
            "icon_name": "consultation",
            "heading": "Human guidance before you choose",
            "body": "Ask for help with intention, zodiac, gifting, or daily-wear suitability before buying."
          }
        },
        {
          "type": "prop",
          "settings": {
            "icon_name": "shipping",
            "heading": "Packed, shipped, and supported",
            "body": "Gift-ready dispatch, practical delivery help, and after-purchase support from the team."
          }
        }
      ]
    }
  ]
}
{% endschema %}
