<div class="social-proof-section section-block-{{ section.id }}">
  <div class="{% if section.settings.container == 'fullwidth' %}container-full{% elsif section.settings.container == '1770' %}container-1770{% elsif section.settings.container == '1170' %}container-1170{% else %}container{% endif %}">
    <div class="social-proof-wrapper" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;">
      
      <!-- Header -->
      {% if section.settings.show_header %}
        <div class="social-proof-header">
          {% if section.settings.eyebrow != blank %}
            <p class="social-proof-kicker">{{ section.settings.eyebrow }}</p>
          {% endif %}
          
          {% if section.settings.title != blank %}
            <h2 class="social-proof-title">{{ section.settings.title }}</h2>
          {% endif %}
        </div>
      {% endif %}

      <!-- Stats Row -->
      <div class="social-proof-stats">
        {% assign stat_blocks = section.blocks | where: 'type', 'stat' %}
        {% for block in stat_blocks %}
          <div class="stat-item" {{ block.shopify_attributes }}>
            {% if block.settings.stat_number != blank %}
              <p class="stat-number">{{ block.settings.stat_number }}</p>
            {% endif %}
            
            {% if block.settings.stat_label != blank %}
              <p class="stat-label">{{ block.settings.stat_label }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <!-- Badges Row -->
      <div class="social-proof-badges">
        {% assign badge_blocks = section.blocks | where: 'type', 'badge' %}
        {% for block in badge_blocks %}
          <div class="proof-badge" {{ block.shopify_attributes }}>
            <!-- Badge Icon/Image -->
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 100 }}"
                alt="{{ block.settings.badge_text }}"
                class="badge-image"
              >
            {% else %}
              <div class="badge-icon-placeholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
            {% endif %}

            <!-- Badge Text -->
            {% if block.settings.badge_text != blank %}
              <p class="badge-text">{{ block.settings.badge_text }}</p>
            {% endif %}
            
            {% if block.settings.badge_subtext != blank %}
              <p class="badge-subtext">{{ block.settings.badge_subtext }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <!-- Trust Testimonial -->
      {% if section.settings.show_testimonial %}
        <div class="social-proof-testimonial">
          {% if section.settings.testimonial_text != blank %}
            <p class="testimonial-text">"{{ section.settings.testimonial_text }}"</p>
          {% endif %}

          <div class="testimonial-author">
            {% if section.settings.author_image != blank %}
              <img 
                src="{{ section.settings.author_image | image_url: width: 60 }}"
                alt="{{ section.settings.author_name }}"
                class="author-avatar"
              >
            {% endif %}

            <div class="author-info">
              {% if section.settings.author_name != blank %}
                <p class="author-name">{{ section.settings.author_name }}</p>
              {% endif %}
              
              {% if section.settings.author_title != blank %}
                <p class="author-title">{{ section.settings.author_title }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}

      <!-- Bottom Text -->
      {% if section.settings.bottom_text != blank %}
        <p class="social-proof-bottom-text">{{ section.settings.bottom_text }}</p>
      {% endif %}
    </div>
  </div>
</div>

<style>
.social-proof-section {
  background: var(--color-background-secondary);
  padding: var(--space-section) 0;
}

.social-proof-header {
  text-align: center;
  margin-bottom: var(--space-xl);
}

.social-proof-kicker {
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-primary);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: var(--space-xs);
}

.social-proof-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
}

.social-proof-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--space-lg);
  margin-bottom: var(--space-xl);
  padding: var(--space-lg);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
}

@media (max-width: 768px) {
  .social-proof-stats {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    padding: var(--space-md);
  }
}

@media (max-width: 480px) {
  .social-proof-stats {
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: clamp(1.5rem, 3vw, 2.5rem);
  font-weight: var(--font-bold);
  color: var(--color-primary);
  margin-bottom: var(--space-xs);
}

.stat-label {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-regular);
}

.social-proof-badges {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: var(--space-lg);
  margin-bottom: var(--space-xl);
}

@media (max-width: 768px) {
  .social-proof-badges {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
}

@media (max-width: 480px) {
  .social-proof-badges {
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }
}

.proof-badge {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  text-align: center;
  transition: all var(--duration-normal) var(--ease-out-expo);
}

.proof-badge:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-md);
}

.badge-image {
  width: 60px;
  height: 60px;
  margin: 0 auto var(--space-md);
  display: block;
}

.badge-icon-placeholder {
  width: 60px;
  height: 60px;
  margin: 0 auto var(--space-md);
  background: var(--color-background-secondary);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
}

.badge-text {
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-xs);
}

.badge-subtext {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.social-proof-testimonial {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-primary);
  padding: var(--space-lg);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-lg);
}

.testimonial-text {
  font-size: var(--text-lg);
  font-style: italic;
  color: var(--color-text-primary);
  margin-bottom: var(--space-md);
  line-height: var(--line-height-relaxed);
}

.testimonial-author {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.author-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
}

.author-info {
  flex: 1;
}

.author-name {
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-xs);
}

.author-title {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.social-proof-bottom-text {
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  max-width: 600px;
  margin: 0 auto;
}
</style>

{% schema %}
{
  "name": "Social Proof Section",
  "tag": "section",
  "class": "section-social-proof",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "default": "1770",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "1170", "label": "1170px" },
        { "value": "1770", "label": "1770px" },
        { "value": "fullwidth", "label": "Full width" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted By Thousands"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Customers Love Gift Palace"
    },
    {
      "type": "checkbox",
      "id": "show_testimonial",
      "label": "Show testimonial",
      "default": true
    },
    {
      "type": "textarea",
      "id": "testimonial_text",
      "label": "Testimonial text",
      "default": "The quality and attention to detail in every piece is exceptional. These aren't just beautiful, they're truly meaningful."
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "Sarah M."
    },
    {
      "type": "text",
      "id": "author_title",
      "label": "Author title",
      "default": "Verified Buyer"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author image"
    },
    {
      "type": "textarea",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "Join thousands of satisfied customers who have found their perfect gemstone"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Side padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "stat_number",
          "label": "Number",
          "default": "50K+"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Label",
          "default": "Happy Customers"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Badge image or logo"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "Award Winner"
        },
        {
          "type": "text",
          "id": "badge_subtext",
          "label": "Subtext",
          "default": "2024"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof Section"
    }
  ]
}
{% endschema %}
