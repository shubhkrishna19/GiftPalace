# Shopify Theme ignore
.shopify-cli
.shopify
config/settings_data.json
# Note: Keep config/settings_data.json if you want to preserve theme settings in Git.
# Many developers ignore it to prevent overwriting settings between environments.

# OS Files
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/

# Workspace state - not part of the Shopify theme upload
.claude/
backup/
tmp/
assets/.stash/

# docs/ (specs, plans, archives) is intentionally tracked as project history
