{
  "sections": {
    "main": {
      "type": "gpi-product-main",
      "settings": {
        "show_vendor": true,
        "show_sku": true,
        "show_buynow": true,
        "sticky_info": true,
        "gallery_layout": "thumbs-bottom"
      }
    },
    "tabs": {
      "type": "gpi-product-tabs",
      "blocks": {
        "description": {"type": "description", "settings": {"title": "Description"}},
        "specs":       {"type": "specs",       "settings": {"title": "Specifications"}},
        "care":        {"type": "rich_text",   "settings": {"title": "Care", "content": "<p>Store in the pouch provided. Avoid contact with perfumes and chemicals. Clean gently with a soft, dry cloth. Recharge crystals in moonlight monthly.</p>"}},
        "shipping":    {"type": "rich_text",   "settings": {"title": "Shipping & Returns", "content": "<p>Free India shipping on orders above ₹2,999. Easy 7-day returns. International shipping available on request.</p>"}},
        "reviews":     {"type": "reviews",     "settings": {"title": "Reviews"}}
      },
      "block_order": ["description", "specs", "care", "shipping", "reviews"]
    },
    "fbt": {
      "type": "gpi-product-fbt",
      "settings": {"heading": "Frequently bought together"}
    },
    "ring_size": {
      "type": "ring-size-guide",
      "settings": {
        "title": "Find Your Perfect Ring Size",
        "subtitle": "Already have a ring that fits? Use this simple method to find your exact size.",
        "accordion_title": "Find Your Ring Size",
        "whatsapp_number": "917011099721",
        "whatsapp_button_text": "Chat on WhatsApp"
      }
    },
    "recommendations": {
      "type": "gpi-related-products",
      "settings": {"heading": "You may also like", "limit": 8}
    },
    "recently_viewed": {
      "type": "gpi-product-recently-viewed",
      "settings": {"heading": "Recently viewed"}
    }
  },
  "order": ["main", "tabs", "fbt", "ring_size", "recommendations", "recently_viewed"]
}
