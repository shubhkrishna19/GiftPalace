<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gift card · {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'gpi-design-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'component-gpi-foundation.css' | asset_url | stylesheet_tag }}
  {{ 'component-gpi-edge.css' | asset_url | stylesheet_tag }}
  <style>
    body { font-family: var(--gpi-body); background: var(--gpi-surface-ivory); margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; color: var(--gpi-ink); }
    .gpi-gift {
      max-width: 480px; width: 100%;
      background: var(--gpi-surface-card);
      border-radius: var(--gpi-radius-card);
      box-shadow: var(--gpi-shadow-mid);
      padding: 32px;
      text-align: center;
    }
    .gpi-gift__brand { font-family: var(--gpi-heading); font-size: 22px; letter-spacing: 0.06em; color: var(--gpi-ink-strong); margin-bottom: 16px; }
    .gpi-gift__amount { font-family: var(--gpi-heading); font-size: clamp(40px, 6vw, 64px); color: var(--gpi-gold); margin: 8px 0 4px; }
    .gpi-gift__label { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gpi-text-muted); }
    .gpi-gift__qr { margin: 24px 0; }
    .gpi-gift__qr img { width: 160px; height: 160px; }
    .gpi-gift__code {
      display: block;
      font-family: 'Courier New', monospace;
      font-size: 18px;
      letter-spacing: 0.16em;
      background: var(--gpi-surface-ivory);
      border-radius: var(--gpi-radius-small);
      padding: 12px 16px;
      margin: 12px 0;
      word-break: break-all;
    }
    .gpi-gift__instructions { font-size: 13px; color: var(--gpi-text-muted); line-height: 1.5; margin: 16px 0; }
    .gpi-gift__cta a { display: inline-block; padding: 12px 24px; background: var(--gpi-ink); color: var(--gpi-surface-canvas); text-decoration: none; border-radius: var(--gpi-radius-pill); font-size: 14px; }
    @media print { body { background: white; } .gpi-gift__cta, .gpi-gift__wallet { display: none; } }
  </style>
</head>
<body>
  <main class="gpi-gift">
    <p class="gpi-gift__brand">GIFT PALACE</p>
    <p class="gpi-gift__label">Gift card</p>
    <p class="gpi-gift__amount">{{ gift_card.balance | money_without_trailing_zeros }}</p>
    <p class="gpi-gift__label">Initial value: {{ gift_card.initial_value | money_without_trailing_zeros }}</p>

    <div class="gpi-gift__qr">
      <img src="{{ gift_card.qr_identifier_url }}" alt="QR code for gift card" width="160" height="160">
    </div>

    <code class="gpi-gift__code">{{ gift_card.code | format_code }}</code>

    <p class="gpi-gift__instructions">Use this code at checkout — or scan the QR with your camera to redeem in seconds. The full balance can be split across multiple orders.</p>

    {% if gift_card.expired %}
      <p style="color:#8a1c2b; font-weight: 600;">This card expired on {{ gift_card.expires_on | date: '%d %b %Y' }}.</p>
    {% elsif gift_card.expires_on %}
      <p class="gpi-gift__instructions">Valid until {{ gift_card.expires_on | date: '%d %b %Y' }}.</p>
    {% endif %}

    <div class="gpi-gift__cta">
      <a href="{{ shop.url }}">Start shopping</a>
    </div>

    {% if gift_card.pass_url %}
      <p class="gpi-gift__wallet" style="margin-top: 12px;">
        <a href="{{ gift_card.pass_url }}">Add to Apple Wallet →</a>
      </p>
    {% endif %}
  </main>
</body>
</html>
