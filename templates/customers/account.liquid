{% layout 'theme' %}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-customer.css' | asset_url }}">

<section class="gpi-account">
  <div class="gpi-container">
    <h1 class="gpi-account__hi">Hi, {{ customer.first_name | default: 'friend' }}</h1>
    <p class="gpi-account__sub">{{ customer.email }} — member since {{ customer.created_at | date: '%B %Y' }}</p>

    <div class="gpi-account__layout">
      <nav class="gpi-account__nav" aria-label="Account">
        <ul role="list">
          <li><a href="#orders" class="is-active">Orders</a></li>
          <li><a href="{{ routes.account_addresses_url }}">Addresses</a></li>
          <li><a href="/pages/wishlist">Wishlist</a></li>
          <li><a href="{{ routes.account_logout_url }}" class="is-logout">Sign out</a></li>
        </ul>
      </nav>

      <div class="gpi-account__panel" id="orders">
        <h2 class="gpi-account__panel-heading">Order history</h2>
        {% if customer.orders.size > 0 %}
          <ul class="gpi-orders" role="list">
            <li class="gpi-orders__row gpi-orders__row--head"><span>Order</span><span>Date</span><span>Total</span><span>Status</span><span></span></li>
            {% for order in customer.orders %}
              <li class="gpi-orders__row">
                <span>{{ order.name }}</span>
                <span>{{ order.created_at | date: '%d %b %Y' }}</span>
                <span>{{ order.total_price | money }}</span>
                <span><span class="gpi-orders__status" data-status="{{ order.fulfillment_status_label | downcase }}">{{ order.fulfillment_status_label }}</span></span>
                <span><a href="{{ order.customer_url }}">View →</a></span>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p style="color:var(--gpi-text-muted);">No orders yet. <a href="/collections/all" style="color:var(--gpi-gold);">Start browsing →</a></p>
        {% endif %}
      </div>
    </div>
  </div>
</section>
