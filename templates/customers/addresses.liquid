{% layout 'theme' %}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-customer.css' | asset_url }}">

<section class="gpi-account">
  <div class="gpi-container">
    <h1 class="gpi-account__hi">Saved addresses</h1>
    <p class="gpi-account__sub"><a href="{{ routes.account_url }}" style="color:var(--gpi-gold);">← Back to account</a></p>

    {% paginate customer.addresses by 6 %}
      {% for address in customer.addresses %}
        <div class="gpi-address-card">
          <div>{{ address | format_address }}</div>
          <div class="gpi-address-card__row">
            <a href="#" onclick="document.getElementById('EditAddress_{{ address.id }}').style.display='block';return false;">Edit</a>
            <span>·</span>
            {{ 'Delete' | customer_address_delete_link: form_id: 'DeleteAddress_' | append: address.id, target_form_attribute: 'data-form-id' }}
            {% if address == customer.default_address %}<span style="color:var(--gpi-gold);">· Default</span>{% endif %}
          </div>
          <div id="EditAddress_{{ address.id }}" style="display:none; margin-top:12px;">
            {% form 'customer_address', address, class: 'gpi-customer__form' %}
              <div class="gpi-customer__field"><label>First name</label><input type="text" name="address[first_name]" value="{{ form.first_name }}"></div>
              <div class="gpi-customer__field"><label>Last name</label><input type="text" name="address[last_name]" value="{{ form.last_name }}"></div>
              <div class="gpi-customer__field"><label>Address</label><input type="text" name="address[address1]" value="{{ form.address1 }}"></div>
              <div class="gpi-customer__field"><label>City</label><input type="text" name="address[city]" value="{{ form.city }}"></div>
              <div class="gpi-customer__field"><label>ZIP</label><input type="text" name="address[zip]" value="{{ form.zip }}"></div>
              <div class="gpi-customer__field"><label>Phone</label><input type="tel" name="address[phone]" value="{{ form.phone }}"></div>
              <button type="submit" class="gpi-button gpi-button--primary gpi-button--md">Save</button>
            {% endform %}
          </div>
        </div>
      {% endfor %}
    {% endpaginate %}

    <details style="margin-top:24px;">
      <summary class="gpi-button gpi-button--secondary gpi-button--md">+ Add a new address</summary>
      <div style="margin-top:16px;">
        {% form 'customer_address', customer.new_address, class: 'gpi-customer__form' %}
          {% if form.errors %}<div class="gpi-customer__errors">{{ form.errors | default_errors }}</div>{% endif %}
          <div class="gpi-customer__field"><label>First name</label><input type="text" name="address[first_name]"></div>
          <div class="gpi-customer__field"><label>Last name</label><input type="text" name="address[last_name]"></div>
          <div class="gpi-customer__field"><label>Address line 1</label><input type="text" name="address[address1]"></div>
          <div class="gpi-customer__field"><label>Address line 2 (optional)</label><input type="text" name="address[address2]"></div>
          <div class="gpi-customer__field"><label>City</label><input type="text" name="address[city]"></div>
          <div class="gpi-customer__field"><label>State / Region</label><input type="text" name="address[province]"></div>
          <div class="gpi-customer__field"><label>ZIP / Postal code</label><input type="text" name="address[zip]"></div>
          <div class="gpi-customer__field"><label>Phone</label><input type="tel" name="address[phone]"></div>
          <label style="display:flex; gap:8px; font-size:13px;"><input type="checkbox" name="address[default]" value="1"> Make this my default address</label>
          <button type="submit" class="gpi-button gpi-button--primary gpi-button--md">Add address</button>
        {% endform %}
      </div>
    </details>
  </div>
</section>
