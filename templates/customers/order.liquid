{% layout 'theme' %}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-customer.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-cart.css' | asset_url }}">

<section class="gpi-account">
  <div class="gpi-container">
    <p class="gpi-account__sub"><a href="{{ routes.account_url }}" style="color:var(--gpi-gold);">← Back to orders</a></p>
    <h1 class="gpi-account__hi">{{ order.name }}</h1>
    <p class="gpi-account__sub">Placed {{ order.created_at | date: '%d %B %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>

    <div class="gpi-account__layout">
      <aside class="gpi-account__nav" style="position:static;">
        <h3 style="font-family:var(--gpi-heading); font-size:15px; margin:0 0 12px;">Shipping address</h3>
        <p style="font-size:13px; color:var(--gpi-text-muted); line-height:1.6; margin:0;">{{ order.shipping_address | format_address }}</p>
        <hr class="gpi-customer__divider">
        <h3 style="font-family:var(--gpi-heading); font-size:15px; margin:0 0 12px;">Billing address</h3>
        <p style="font-size:13px; color:var(--gpi-text-muted); line-height:1.6; margin:0;">{{ order.billing_address | format_address }}</p>
      </aside>

      <div class="gpi-account__panel">
        <h2 class="gpi-account__panel-heading">Order summary</h2>
        <ul class="gpi-orders" role="list">
          <li class="gpi-orders__row gpi-orders__row--head"><span>Item</span><span>Qty</span><span>Price</span><span>Total</span><span></span></li>
          {% for line_item in order.line_items %}
            <li class="gpi-orders__row">
              <span>{{ line_item.product.title }}{% unless line_item.product.has_only_default_variant %}<br><small style="color:var(--gpi-text-soft)">{{ line_item.variant.title }}</small>{% endunless %}</span>
              <span>{{ line_item.quantity }}</span>
              <span>{{ line_item.price | money }}</span>
              <span>{{ line_item.final_line_price | money }}</span>
              <span></span>
            </li>
          {% endfor %}
        </ul>
        <dl class="gpi-cart-summary__rows" style="margin-top:24px;">
          <dt>Subtotal</dt><dd>{{ order.subtotal_price | money }}</dd>
          {% for discount in order.discount_applications %}<dt>{{ discount.title }}</dt><dd>−{{ discount.total_allocated_amount | money }}</dd>{% endfor %}
          <dt>Shipping</dt><dd>{{ order.shipping_price | money }}</dd>
          <dt>Tax</dt><dd>{{ order.tax_price | money }}</dd>
        </dl>
        <div class="gpi-cart-summary__total"><span>Total</span><strong>{{ order.total_price | money }}</strong></div>
      </div>
    </div>
  </div>
</section>
