{% layout 'theme' %}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-customer.css' | asset_url }}">

<section class="gpi-customer">
  <div class="gpi-container gpi-customer__shell">
    <div class="gpi-customer__mark"><span class="wordmark">GIFT PALACE</span></div>
    <h1 class="gpi-customer__heading">Create your account</h1>
    <p class="gpi-customer__lede">Save addresses, track orders, and unlock perks reserved for the Gift Palace circle.</p>

    {% form 'create_customer', class: 'gpi-customer__form' %}
      {% if form.errors %}<div class="gpi-customer__errors">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="gpi-customer__field"><label for="FirstName">First name</label><input id="FirstName" type="text" name="customer[first_name]" autocomplete="given-name" required></div>
      <div class="gpi-customer__field"><label for="LastName">Last name</label><input id="LastName" type="text" name="customer[last_name]" autocomplete="family-name" required></div>
      <div class="gpi-customer__field"><label for="Email">Email</label><input id="Email" type="email" name="customer[email]" autocomplete="email" required></div>
      <div class="gpi-customer__field"><label for="Password">Password</label><input id="Password" type="password" name="customer[password]" autocomplete="new-password" required minlength="6"></div>
      <label style="display:flex; gap:8px; font-size:13px; color:var(--gpi-text-muted); align-items:flex-start;">
        <input type="checkbox" name="customer[accepts_marketing]" value="1" checked style="margin-top:3px;">
        <span>Send me quiet emails on new arrivals, zodiac drops, and pieces our team is wearing.</span>
      </label>
      <button type="submit" class="gpi-button gpi-button--primary gpi-button--lg gpi-button--block">Create account</button>
    {% endform %}

    <hr class="gpi-customer__divider">
    <p class="gpi-customer__alt">Already have an account? <a href="{{ routes.account_login_url }}">Sign in →</a></p>
  </div>
</section>
