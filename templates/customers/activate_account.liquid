{% layout 'theme' %}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-customer.css' | asset_url }}">

<section class="gpi-customer">
  <div class="gpi-container gpi-customer__shell">
    <div class="gpi-customer__mark"><span class="wordmark">GIFT PALACE</span></div>
    <h1 class="gpi-customer__heading">Activate your account</h1>
    <p class="gpi-customer__lede">Set a password to claim your account and get started.</p>
    {% form 'activate_customer_password', class: 'gpi-customer__form' %}
      {% if form.errors %}<div class="gpi-customer__errors">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="gpi-customer__field"><label for="Password">Password</label><input id="Password" type="password" name="customer[password]" required minlength="6"></div>
      <div class="gpi-customer__field"><label for="PasswordConfirm">Confirm password</label><input id="PasswordConfirm" type="password" name="customer[password_confirmation]" required minlength="6"></div>
      <button type="submit" class="gpi-button gpi-button--primary gpi-button--lg gpi-button--block">Activate account</button>
    {% endform %}
  </div>
</section>
