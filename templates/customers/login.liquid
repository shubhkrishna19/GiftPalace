{% layout 'theme' %}
<link rel="stylesheet" href="{{ 'component-gpi-foundation.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-gpi-customer.css' | asset_url }}">

<section class="gpi-customer">
  <div class="gpi-container gpi-customer__shell">
    <div class="gpi-customer__mark"><span class="wordmark">GIFT PALACE</span></div>
    <h1 class="gpi-customer__heading">Welcome back</h1>
    <p class="gpi-customer__lede">Sign in to view orders, manage addresses, and pick up where you left off.</p>

    {% form 'customer_login', class: 'gpi-customer__form' %}
      {% if form.errors %}<div class="gpi-customer__errors">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="gpi-customer__field"><label for="CustomerEmail">Email</label><input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required></div>
      {% if form.password_needed %}
      <div class="gpi-customer__field">
        <label for="CustomerPassword">Password</label>
        <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>
        <a href="#recover" class="gpi-customer__forgot" onclick="document.getElementById('RecoverEmail-wrap').style.display='block';return false;">Forgot password?</a>
      </div>
      {% endif %}
      <button type="submit" class="gpi-button gpi-button--primary gpi-button--lg gpi-button--block">Sign in</button>
    {% endform %}

    <div id="RecoverEmail-wrap" style="display:none;margin-top:16px">
      <hr class="gpi-customer__divider">
      {% form 'recover_customer_password', class: 'gpi-customer__form' %}
        {% if form.posted_successfully? %}<div class="gpi-customer__success">We sent a reset link to your email.</div>{% endif %}
        <div class="gpi-customer__field"><label for="RecoverEmail">Reset password</label><input id="RecoverEmail" type="email" name="email" autocomplete="email" required placeholder="Email address"></div>
        <button type="submit" class="gpi-button gpi-button--secondary gpi-button--md gpi-button--block">Send reset link</button>
      {% endform %}
    </div>

    <hr class="gpi-customer__divider">
    <p class="gpi-customer__alt">New to Gift Palace? <a href="{{ routes.account_register_url }}">Create an account →</a></p>
  </div>
</section>
