    "home_faq": {
      "type": "home-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "Are your gemstones certified?",
            "answer": "<p>Yes. Every gemstone we sell comes with a lab certificate from a recognised gemmological institute. You can request the certificate before purchase.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>We ship worldwide with full insurance. International orders typically arrive within 7–14 business days depending on your location.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Can I get a consultation before buying?",
            "answer": "<p>Absolutely. Book a free video consultation or visit one of our Delhi stores. Our experts will guide you to the right gemstone for your needs and budget.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 7-day return policy on most items. Customised pieces are non-returnable. Contact us within 7 days of delivery and we will arrange a hassle-free return.</p>"
          }
        }
      },
